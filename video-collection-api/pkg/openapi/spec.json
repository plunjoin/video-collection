  "components": {
    "securitySchemes": {
      "CookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "auth_token",
        "description": "基于 HTTP Cookie 的会话认证"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token",
        "description": "基于 Authorization 标头的 Bearer Token 认证"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "未授权 / 登录凭据失效",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "权限不足 / 需管理员角色",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "CommonResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 1 },
          "msg": { "type": "string", "example": "操作成功" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 0 },
          "error": { "type": "string", "example": "错误描述信息" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "admin" },
          "password": { "type": "string", "example": "admin123" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "newuser" },
          "password": { "type": "string", "example": "mypassword" },
          "nickname": { "type": "string", "example": "极客影迷" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 1 },
          "msg": { "type": "string", "example": "登录成功" },
          "token": { "type": "string", "example": "sess_89f3b140ae2b4c..." },
          "user": { "$ref": "#/components/schemas/UserInfo" }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "username": { "type": "string", "example": "admin" },
          "nickname": { "type": "string", "example": "系统管理员" },
          "avatar": { "type": "string", "example": "https://api.dicebear.com/7.x/identicon/svg?seed=admin" },
          "role": { "type": "string", "example": "admin" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "username": { "type": "string", "example": "user01" },
          "nickname": { "type": "string", "example": "小明" },
          "avatar": { "type": "string", "example": "" },
          "role": { "type": "string", "enum": ["admin", "user"], "example": "user" },
          "status": { "type": "integer", "description": "1 正常, 0 禁用", "example": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "pid": { "type": "integer", "example": 0 },
          "name": { "type": "string", "example": "动作片" },
          "sort": { "type": "integer", "example": 10 }
        }
      },
      "PlayUrl": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "第01集" },
          "url": { "type": "string", "example": "https://cdn.example.com/play/ep01.m3u8" }
        }
      },
      "PlayGroup": {
        "type": "object",
        "properties": {
          "source": { "type": "string", "example": "量子云播" },
          "urls": { "type": "array", "items": { "$ref": "#/components/schemas/PlayUrl" } }
        }
      },
      "VideoRecord": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1001 },
          "name": { "type": "string", "example": "星际穿越" },
          "sub_name": { "type": "string", "example": "Interstellar" },
          "type_id": { "type": "integer", "example": 1 },
          "type_name": { "type": "string", "example": "科幻片" },
          "picture": { "type": "string", "example": "https://example.com/cover.jpg" },
          "actor": { "type": "string", "example": "马修·麦康纳, 安妮·海瑟薇" },
          "director": { "type": "string", "example": "克里斯托弗·诺兰" },
          "area": { "type": "string", "example": "美国" },
          "language": { "type": "string", "example": "英语" },
          "year": { "type": "string", "example": "2014" },
          "remarks": { "type": "string", "example": "超清原盘中字" },
          "content": { "type": "string", "example": "影片讲述了一组宇航员通过穿越虫洞为人类寻找新家园的故事..." },
          "source_id": { "type": "string", "example": "src_1" },
          "hits": { "type": "integer", "example": 2350 },
          "play_groups": { "type": "array", "items": { "$ref": "#/components/schemas/PlayGroup" } },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "VideoListResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 1 },
          "msg": { "type": "string", "example": "数据列表" },
          "page": { "type": "integer", "example": 1 },
          "pagecount": { "type": "integer", "example": 15 },
          "limit": { "type": "integer", "example": 20 },
          "total": { "type": "integer", "example": 300 },
          "list": { "type": "array", "items": { "$ref": "#/components/schemas/VideoRecord" } }
        }
      },
      "UserHistoryItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "user_id": { "type": "integer", "example": 1 },
          "video_id": { "type": "integer", "example": 1001 },
          "video_name": { "type": "string", "example": "星际穿越" },
          "picture": { "type": "string", "example": "https://example.com/cover.jpg" },
          "episode_name": { "type": "string", "example": "第01集" },
          "route_index": { "type": "integer", "example": 0 },
          "episode_index": { "type": "integer", "example": 0 },
          "current_time": { "type": "integer", "description": "播放进度秒数", "example": 1280 },
          "duration": { "type": "integer", "description": "总时长秒数", "example": 7200 },
          "progress": { "type": "number", "format": "float", "example": 17.7 },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "UserFavoriteItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "user_id": { "type": "integer", "example": 1 },
          "video_id": { "type": "integer", "example": 1001 },
          "video_name": { "type": "string", "example": "星际穿越" },
          "picture": { "type": "string", "example": "https://example.com/cover.jpg" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "SourceConfig": {
        "type": "object",
        "required": ["name", "api"],
        "properties": {
          "id": { "type": "string", "example": "src_maccms" },
          "name": { "type": "string", "example": "量子云资源站" },
          "api": { "type": "string", "example": "https://api.example.com/api.php/provide/vod" },
          "type": { "type": "string", "enum": ["json", "xml"], "default": "json" },
          "collect_hours": { "type": "integer", "default": 24 },
          "is_active": { "type": "boolean", "default": true }
        }
      },
      "AdminStats": {
        "type": "object",
        "properties": {
          "total_videos": { "type": "integer", "example": 15840 },
