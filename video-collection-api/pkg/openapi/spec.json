          "description": { "type": "string", "example": "免VIP超清在线影视播放聚合平台" },
          "announcement": { "type": "string", "example": "欢迎使用全新纯后端 API 服务平台！" },
          "icp": { "type": "string", "example": "京ICP备12345678号" }
        }
      },
      "Feedback": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "type": { "type": "string", "enum": ["request", "report", "suggest"], "example": "request" },
          "title": { "type": "string", "example": "求片：阿凡达 3" },
