{
  "openapi": "3.0.3",
  "info": {
    "title": "MacCMS v10 智能采集聚合平台 RESTful API",
    "version": "1.0.0",
    "description": "MacCMS v10 视频智能采集聚合平台 & 客户端纯后端 RESTful API 服务接口文档。\n\n本服务已全面完成前后端分离重构，移除了内部模板与前端静态页面，专注于提供高性能、高可用、标准规范的数据接口服务。\n\n### 认证机制说明\n- 管理员接口与用户个人中心接口支持通过 Cookie 认证（`auth_token`）或 HTTP 请求头传递 Authorization Token（`Bearer <token>`）。\n- 公开接口无需任何鉴权即可直接调用。",
    "contact": {
      "name": "API 维护团队",
      "email": "support@video-collection.local"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "当前服务节点"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "用户认证与登录会话管理" },
    { "name": "Videos", "description": "视频检索、详情与排行榜" },
    { "name": "Categories", "description": "视频分类信息" },
    { "name": "User", "description": "用户个人中心（播放历史、云端同步、追剧收藏）" },
    { "name": "Player", "description": "播放器插件与配置" },
    { "name": "Site", "description": "站点公开配置与用户求片留言" },
    { "name": "Admin - Dashboard", "description": "管理员控制台统计看板" },
    { "name": "Admin - Sources", "description": "采集源管理与实时采集调度" },
    { "name": "Admin - Videos", "description": "视频数据维护与批量操作" },
    { "name": "Admin - Users", "description": "用户账号与权限管理" },
    { "name": "Admin - Themes", "description": "客户端主题模板管理" },
    { "name": "Admin - Players", "description": "播放器引擎与插件管理" },
    { "name": "Admin - Site", "description": "全局系统配置与自动计划任务" },
    { "name": "Admin - Feedbacks", "description": "求片留言工单处理" },
    { "name": "Admin - Logs", "description": "采集日志与操作审计" },
    { "name": "RSS", "description": "RSS 2.0 聚合订阅源" }
  ],
  "paths": {
    "/api/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "用户/管理员登录",
        "description": "验证用户名与密码，生成 Session Token 并设置 Cookie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": { "description": "参数解析失败", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "用户名或密码错误", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "账号被禁用", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "用户快速注册",
        "description": "注册普通用户账号",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": { "description": "用户名已存在或参数不规范", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "退出登录",
        "description": "清除当前用户的 Session 会话并注销 Cookie",
        "responses": {
          "200": {
            "description": "退出成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CommonResponse" }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "获取当前登录用户信息",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "用户信息",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "data": { "$ref": "#/components/schemas/UserInfo" }
                  }
                }
              }
            }
          },
          "401": { "description": "未登录", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "获取视频分类列表",
        "description": "获取系统内维护的标准视频一级与二级分类",
        "responses": {
          "200": {
            "description": "分类列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Category" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/videos": {
      "get": {
        "tags": ["Videos"],
        "summary": "分页检索视频列表",
        "description": "支持多种维度筛选、关键字模糊搜索以及排序",
        "parameters": [
          { "name": "wd", "in": "query", "description": "搜索关键字", "schema": { "type": "string" } },
          { "name": "t", "in": "query", "description": "分类 ID", "schema": { "type": "integer" } },
          { "name": "pg", "in": "query", "description": "当前页码", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "description": "每页条数", "schema": { "type": "integer", "default": 20 } },
          { "name": "from", "in": "query", "description": "按采集源筛选", "schema": { "type": "string" } },
          { "name": "year", "in": "query", "description": "按上映年份筛选", "schema": { "type": "string" } },
          { "name": "area", "in": "query", "description": "按地区筛选", "schema": { "type": "string" } },
          { "name": "lang", "in": "query", "description": "按语言筛选", "schema": { "type": "string" } },
          { "name": "by", "in": "query", "description": "排序依据（time/hits/score/id）", "schema": { "type": "string", "default": "time" } },
          { "name": "order", "in": "query", "description": "升降序（asc/desc）", "schema": { "type": "string", "default": "desc" } }
        ],
        "responses": {
          "200": {
            "description": "视频列表与分页信息",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoListResponse" }
              }
            }
          }
        }
      }
    },
    "/api/video": {
      "get": {
        "tags": ["Videos"],
        "summary": "获取指定视频详情",
        "description": "包含影片详细介绍、演职员、多线路播放源列表与集数切片",
        "parameters": [
          { "name": "id", "in": "query", "required": true, "description": "视频 ID", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "视频详情",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "data": { "$ref": "#/components/schemas/VideoRecord" }
                  }
                }
              }
            }
          },
          "404": { "description": "视频不存在", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/video/detail": {
      "get": {
        "tags": ["Videos"],
        "summary": "获取指定视频详情 (别名接口)",
        "parameters": [
          { "name": "id", "in": "query", "required": true, "description": "视频 ID", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "视频详情",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "data": { "$ref": "#/components/schemas/VideoRecord" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/video/hit": {
      "post": {
        "tags": ["Videos"],
        "summary": "累加视频播放热度点击数",
        "parameters": [
          { "name": "id", "in": "query", "required": true, "description": "视频 ID", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "累加成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "hits": { "type": "integer", "example": 1024 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/rankings": {
      "get": {
        "tags": ["Videos"],
        "summary": "获取视频排行榜",
        "parameters": [
          { "name": "type", "in": "query", "description": "榜单类型: total(总榜), day(日榜), week(周榜), month(月榜)", "schema": { "type": "string", "default": "total" } },
          { "name": "limit", "in": "query", "description": "返回数量，默认 10", "schema": { "type": "integer", "default": 10 } },
          { "name": "t", "in": "query", "description": "指定分类 ID 过滤", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "榜单数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/VideoRecord" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/latest": {
      "get": {
        "tags": ["Videos"],
        "summary": "获取最新更新的视频列表",
        "parameters": [
          { "name": "limit", "in": "query", "description": "返回数量，默认 20", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "最新视频列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/VideoRecord" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/user/history": {
      "get": {
        "tags": ["User"],
        "summary": "获取用户云端播放历史",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "历史播放进度列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/UserHistoryItem" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["User"],
        "summary": "上报并保存单条播放历史",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserHistoryItem" }
            }
          }
        },
        "responses": {
          "200": { "description": "保存成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommonResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "tags": ["User"],
        "summary": "清空用户播放历史",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "responses": {
          "200": { "description": "清空成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommonResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/user/history/sync": {
      "post": {
        "tags": ["User"],
        "summary": "离线播放历史批量合并同步",
        "description": "用于前端客户端将未登录状态下的本地观看记录同步上传至云端",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": { "type": "array", "items": { "$ref": "#/components/schemas/UserHistoryItem" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "同步成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommonResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/user/favorites": {
      "get": {
        "tags": ["User"],
        "summary": "获取用户追剧收藏列表",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "收藏列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/UserFavoriteItem" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["User"],
        "summary": "添加追剧收藏",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["video_id"],
                "properties": {
                  "video_id": { "type": "integer", "example": 1001 },
                  "vod_name": { "type": "string", "example": "流浪地球" },
                  "vod_pic": { "type": "string", "example": "https://example.com/cover.jpg" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "收藏成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommonResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "tags": ["User"],
        "summary": "取消追剧收藏",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "parameters": [
          { "name": "video_id", "in": "query", "required": true, "description": "视频 ID", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "取消成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommonResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/site/config": {
      "get": {
        "tags": ["Site"],
        "summary": "获取站点公开展示配置",
        "responses": {
          "200": {
            "description": "站点配置",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "data": { "$ref": "#/components/schemas/SiteConfig" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/feedback": {
      "post": {
        "tags": ["Site"],
        "summary": "提交用户求片留言或报错",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "content"],
                "properties": {
                  "type": { "type": "string", "enum": ["request", "report", "suggest"], "default": "request" },
                  "title": { "type": "string", "example": "求片：复仇者联盟" },
                  "content": { "type": "string", "example": "希望能上线 4K 杜比视界版本" },
                  "contact": { "type": "string", "example": "user@example.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "提交成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommonResponse" } } } }
        }
      }
    },
    "/api/player/active": {
      "get": {
        "tags": ["Player"],
        "summary": "获取当前激活的播放器配置与类型",
        "responses": {
          "200": {
            "description": "播放器配置详情",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "data": { "$ref": "#/components/schemas/PlayerInfo" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/stats": {
      "get": {
        "tags": ["Admin - Dashboard"],
        "summary": "获取管理端全局看板统计数据",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "仪表盘统计指标",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "data": { "$ref": "#/components/schemas/AdminStats" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/sources": {
      "get": {
        "tags": ["Admin - Sources"],
        "summary": "获取采集源配置列表",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "采集源列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/SourceConfig" } }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Admin - Sources"],
        "summary": "新增或更新采集源",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SourceConfig" }
            }
          }
        },
        "responses": {
          "200": { "description": "保存成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommonResponse" } } } }
        }
      },
      "delete": {
        "tags": ["Admin - Sources"],
        "summary": "删除采集源",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "query", "required": true, "description": "采集源 ID", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "删除成功", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommonResponse" } } } }
        }
      }
    },
    "/api/admin/sources/test": {
      "post": {
        "tags": ["Admin - Sources"],
        "summary": "测试远程采集源连通性与耗时",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["api"],
                "properties": {
                  "api": { "type": "string", "example": "https://api.example.com/api.php/provide/vod" },
                  "type": { "type": "string", "enum": ["json", "xml"], "default": "json" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "测试结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 1 },
                    "duration_ms": { "type": "integer", "example": 235 },
                    "status": { "type": "string", "example": "ok" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/sources/collect": {
      "post": {
        "tags": ["Admin - Sources"],
        "summary": "手动触发指定采集源采集任务",
        "security": [{ "CookieAuth": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["source_id"],
                "properties": {
                  "source_id": { "type": "string", "example": "zy_main" },
                  "hours": { "type": "integer", "description": "采集小时范围，0 为全量，24 为过去24小时", "default": 24 }
                }
              }
            }
          }
        },
