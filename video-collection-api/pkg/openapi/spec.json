          "is_active": { "type": "boolean", "example": true }
        }
      },
      "PlayerInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "videojs" },
          "name": { "type": "string", "example": "极光超清播放器" },
          "version": { "type": "string", "example": "2.0.0" },
