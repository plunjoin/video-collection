# 复制为 .env 后修改；Docker 下可用 --env-file .env 或 compose 的 env_file 注入
# 优先级：容器/系统环境变量 > .env > config/collector_rules.yaml > 默认值

# 服务监听端口
PORT=8080

# 数据库驱动：postgres / sqlite
DB_DRIVER=postgres

# 方式一：完整连接串（设置后忽略下方分项配置）
# DB_DSN=postgres://postgres:your_password@postgres:5432/videodb?sslmode=disable

# 方式二：分项配置（容器内不要用 localhost，填数据库容器名或宿主机 IP）
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=videodb
DB_SSLMODE=disable

# PostgreSQL 不可用时降级使用的 SQLite 文件路径
SQLITE_PATH=data/collection.db

# 采集规则配置文件路径
# CONFIG_PATH=config/collector_rules.yaml

# 生产环境 PostgreSQL 故障时禁止自动降级，避免写入另一套 SQLite 数据
# DB_REQUIRE_PRIMARY=true
# 仅在空数据库首次初始化时生效；既有管理员密码请在后台修改
# ADMIN_INITIAL_PASSWORD=replace_with_a_long_random_password
# 可编辑采集模板文件，未显式设置时使用 config 下文件或内嵌 YAML
# COLLECTION_TEMPLATES_PATH=config/collection_templates.yaml
