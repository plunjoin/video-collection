# 复制为 .env 后修改；Docker 下可用 --env-file .env 或 compose 的 env_file 注入
# 优先级：容器/系统环境变量 > .env > config/collector_rules.yaml > 默认值

# 服务监听端口
PORT=8080

# 数据库驱动：postgres / sqlite
DB_DRIVER=postgres

# 方式一：完整连接串（设置后忽略下方分项配置）
# DB_DSN=postgres://postgres:your_password@postgres:5432/videodb?sslmode=disable

# 方式二：分项配置（容器内不要用 localhost，填数据库容器名或宿主机 IP）
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=videodb
DB_SSLMODE=disable

# PostgreSQL 不可用时降级使用的 SQLite 文件路径
SQLITE_PATH=data/collection.db

# 采集规则配置文件路径
# CONFIG_PATH=config/collector_rules.yaml

# 生产环境 PostgreSQL 故障时禁止自动降级，避免写入另一套 SQLite 数据
# DB_REQUIRE_PRIMARY=true
# 仅在空数据库首次初始化时生效；既有管理员密码请在后台修改
# ADMIN_INITIAL_PASSWORD=replace_with_a_long_random_password
# 可编辑采集模板文件，未显式设置时使用 config 下文件或内嵌 YAML
# COLLECTION_TEMPLATES_PATH=config/collection_templates.yaml

# ---------------------------------------------------------------------------
# Webhook 回调采集（可选）：密钥信封加密主密钥
# 优先级高于 ADMIN_INITIAL_PASSWORD；不设置时由管理员初始密码派生。
# 变更后所有既有 webhook 密钥需在后台重新轮换才能继续验签
# ---------------------------------------------------------------------------
# WEBHOOK_ENCRYPTION_KEY=replace_with_a_long_random_string

# ---------------------------------------------------------------------------
# radix / Redis（可选）：启用分布式会话与公开读接口缓存
# 未设置 REDIS_ADDR 时服务以「内存会话 + 无缓存」模式运行，功能不受影响
# ---------------------------------------------------------------------------
# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_PREFIX=vc

# ---------------------------------------------------------------------------
# 通用采集 Webhook（POST /api/webhooks/collector）— 环境变量仅作兜底
# 推荐在管理后台「使魔节点管理」为 Webhook 源配置 custom_params.webhook_secret
# （可选 webhook_secret_expires_at），并启用该节点。关闭节点或密钥过期即停收。
# 仅当节点未配置 webhook_secret 时才使用下列变量：
# ---------------------------------------------------------------------------
# COLLECTOR_WEBHOOK_SECRET=replace_with_a_long_random_secret
# ACG_WEBHOOK_SECRET=replace_with_a_long_random_secret

# ---------------------------------------------------------------------------
# RAG 向量知识库（Wiki / 资讯分块检索，默认离线假嵌入）
# ---------------------------------------------------------------------------
# RAG_EMBEDDING_PROVIDER=fake
# RAG_EMBEDDING_DIM=384
# RAG_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com
