{
  "tags": [
    {
      "name": "Integrations",
      "description": "外部服务接入：SMTP 邮件、短信网关、对象存储配置与连通性测试"
    }
  ],
  "paths": {
    "/api/admin/integrations": {
      "get": {
        "tags": [
          "Integrations"
        ],
        "summary": "读取集成配置",
        "description": "返回邮件 / 短信 / 存储三块配置。密钥类字段（pass、token、secret_key）恒为空串，只通过 pass_set、token_set、secret_set 告知是否已配置。全体后台角色可读。",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "CookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "当前配置（已脱敏）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 1
                    },
                    "data": {
                      "$ref": "#/components/schemas/IntegrationConfig"
                    },
                    "dev_mode": {
                      "type": "boolean",
                      "description": "环境变量 ACCOUNT_DEV_CODE=1 时为 true，验证码直接随接口返回而不真正发送"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未登录"
          },
          "403": {
            "description": "无后台访问权限"
          }
        }
      },
      "post": {
        "tags": [
          "Integrations"
        ],
        "summary": "保存集成配置",
        "description": "仅超级管理员可写。密钥字段留空表示沿用已保存的值（因此可以把 GET 拿到的脱敏结果原样回传）。保存后即时生效，无需重启服务。",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "CookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntegrationConfig"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "集成配置已保存",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 1
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/IntegrationConfig"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数解析失败"
          },
          "403": {
            "description": "仅超级管理员可修改集成配置"
          }
        }
      }
    },
    "/api/admin/integrations/test/mail": {
      "post": {
        "tags": [
          "Integrations"
        ],
        "summary": "发送测试邮件",
        "description": "用当前已保存的 SMTP 配置给指定邮箱发一封测试邮件，用于验证账号、密码、端口与加密方式是否匹配。",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "CookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "to"
                ],
                "properties": {
                  "to": {
                    "type": "string",
                    "format": "email",
                    "example": "ops@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "测试邮件已发送"
          },
          "400": {
            "description": "收件邮箱格式不正确"
          },
          "403": {
            "description": "仅超级管理员可执行"
          },
          "502": {
            "description": "发送失败，响应体带 SMTP 返回的错误原因"
          }
        }
      }
    },
    "/api/admin/integrations/test/sms": {
      "post": {
        "tags": [
          "Integrations"
        ],
        "summary": "发送测试短信",
        "description": "用当前已保存的短信网关配置发送一条测试短信，网关返回 HTTP 2xx 视为成功。",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "CookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone"
                ],
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "13800000000"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "测试短信已发送"
          },
          "400": {
            "description": "手机号格式不正确"
          },
          "403": {
            "description": "仅超级管理员可执行"
          },
          "502": {
            "description": "发送失败，响应体带网关返回的错误原因"
          }
        }
      }
    },
    "/api/admin/integrations/test/storage": {
      "post": {
        "tags": [
          "Integrations"
        ],
        "summary": "存储读写探测",
        "description": "用当前已保存的存储配置上传一个 probe/ 下的临时文件，校验写入权限后再删除它，返回对象地址与清理结果。",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "CookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "探测完成（deleted=false 表示上传成功但删除失败，需检查删除权限）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 1
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string",
                          "enum": [
                            "local",
                            "s3"
                          ]
                        },
                        "url": {
                          "type": "string"
                        },
                        "deleted": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "存储配置不可用"
          },
          "403": {
            "description": "仅超级管理员可执行"
          },
          "502": {
            "description": "上传失败，响应体带对象存储返回的错误"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IntegrationConfig": {
        "type": "object",
        "properties": {
          "mail": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "host": {
                "type": "string",
                "example": "smtp.exmail.qq.com"
              },
              "port": {
                "type": "string",
                "example": "465"
              },
              "user": {
                "type": "string"
              },
              "pass": {
                "type": "string",
                "description": "读取时恒为空串；保存时留空表示沿用原密码"
              },
              "pass_set": {
                "type": "boolean",
                "readOnly": true
              },
              "from": {
                "type": "string",
                "format": "email"
              },
              "from_name": {
                "type": "string"
              },
              "encryption": {
                "type": "string",
                "enum": [
                  "ssl",
                  "starttls",
                  "none"
                ]
              },
              "template": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "example": "{{site}} {{purpose}}验证码"
                  },
                  "body": {
                    "type": "string",
                    "description": "支持 {{site}} {{code}} {{purpose}} {{expires}} {{target}} {{email}} 占位符"
                  }
                }
              },
              "configured": {
                "type": "boolean",
                "readOnly": true
              }
            }
          },
          "sms": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "webhook",
                  "none"
                ]
              },
              "webhook_url": {
                "type": "string",
                "description": "POST JSON：{ phone, content }"
              },
              "token": {
                "type": "string",
                "description": "读取时恒为空串；保存时留空表示沿用原令牌。以 Authorization: Bearer 发送"
              },
              "token_set": {
                "type": "boolean",
                "readOnly": true
              },
              "template": {
                "type": "string",
                "description": "支持 {{site}} {{code}} {{purpose}} {{expires}} {{phone}} 占位符"
              },
              "configured": {
                "type": "boolean",
                "readOnly": true
              }
            }
          },
          "storage": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "local",
                  "oss",
                  "s3"
                ],
                "description": "local 写服务端 uploads 目录；oss 走 V1 签名；s3 走 SigV4（兼容 COS / R2 / MinIO / AWS）"
              },
              "endpoint": {
                "type": "string",
                "example": "https://oss-cn-hangzhou.aliyuncs.com"
              },
              "region": {
                "type": "string",
                "description": "留空则尝试从 Endpoint 推断，失败回退 us-east-1"
              },
              "bucket": {
                "type": "string"
              },
              "access_key": {
                "type": "string"
              },
              "secret_key": {
                "type": "string",
                "description": "读取时恒为空串；保存时留空表示沿用原密钥"
              },
              "secret_set": {
                "type": "boolean",
                "readOnly": true
              },
              "domain": {
                "type": "string",
                "description": "自定义访问域名，留空则按 path_style 拼接"
              },
              "prefix": {
                "type": "string",
                "example": "uploads/"
              },
              "path_style": {
                "type": "boolean",
                "description": "true 走 endpoint/bucket/key，false 走 bucket.endpoint/key"
              },
              "configured": {
                "type": "boolean",
                "readOnly": true
              }
            }
          }
        }
      }
    }
  }
}
