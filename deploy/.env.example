# 复制为 deploy/.env，再执行 docker compose --env-file deploy/.env ...
DB_PASSWORD=replace_with_a_long_random_password
ADMIN_INITIAL_PASSWORD=replace_with_another_random_password
BIND_ADDRESS=127.0.0.1
WEB_PORT=4321
ADMIN_PORT=3000
# 后台跳转到前台的地址，按部署域名填写并保留末尾斜杠
PORTAL_URL=http://127.0.0.1:4321/
# 前台站点公网 URL（供 Sitemap、robots.txt、Canonical 绝对规范地址使用，末尾不要斜杠）
SITE_URL=https://video.example.com
