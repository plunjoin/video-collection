# 环境变量示例模板
# 站点公网基础 URL（用于生成 Sitemap、robots.txt、Canonical 规范网址与 OpenGraph 绝对路径）
SITE_URL=https://example.com
PUBLIC_SITE_URL=https://example.com

# 浏览器使用同源 /api；开发服务器和生产 Node 服务均提供代理
PUBLIC_API_URL=
# 生产 Node 服务默认连接 http://localhost:80，可在启动时覆盖
INTERNAL_API_URL=http://localhost:80
# 开发代理可独立覆盖，未设置时读取 INTERNAL_API_URL
# API_PROXY_TARGET=http://localhost:8080
PUBLIC_ENABLE_DEVTOOLS_PROTECTION=false
