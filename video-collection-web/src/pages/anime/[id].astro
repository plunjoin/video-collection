---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AnimeHero from '../../components/AnimeHero.astro';
import DetailTabs from '../../components/DetailTabs.astro';
import EpisodeSelector from '../../components/EpisodeSelector.astro';
import Synopsis from '../../components/Synopsis.astro';
import RelatedAnime from '../../components/RelatedAnime.astro';
import { getVideoDetail } from '../../lib/api';
const { video, related } = await getVideoDetail(Astro.params.id || '0');
---
<Layout title={`${video.name} — bllii`} activeNav="番剧">
  <AnimeHero video={video} />
  <DetailTabs activeTab="选集" />
  <EpisodeSelector videoId={video.id} playGroups={video.play_groups} />
  <Synopsis content={video.content} />
  {video.actor && <section class="brand-section" id="tab-角色"><div class="section-heading"><h2>主要演出</h2></div><p class="text-sm text-slate-500 leading-loose">{video.actor}</p></section>}
  <RelatedAnime items={related} currentVideo={video} />
</Layout>
