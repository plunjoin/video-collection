---
import Layout from '../layouts/Layout.astro';
import { getAnimeVideos } from '../lib/api';

// 构建期抓取热门番剧，客户端随机推荐一部，把错误页变成品牌触点
const animes = await getAnimeVideos(24);
const candidates = animes.map((v) => ({
  id: v.id,
  name: v.name,
  picture: v.picture,
  year: v.year,
  remarks: v.remarks,
}));
---

<Layout title="故事暂时迷路了 — bllii" activeNav="">
  <div class="page-content">
    <div class="page-empty lost-404">
      <div class="lost-404__scene" aria-hidden="true">
        <svg viewBox="0 0 320 190" role="img" class="lost-404__art">
          <circle class="lost-star" cx="36" cy="34" r="2.4" style="animation-delay:.1s" />
          <circle class="lost-star" cx="286" cy="28" r="2" style="animation-delay:.9s" />
          <circle class="lost-star" cx="258" cy="120" r="1.7" style="animation-delay:.5s" />
          <circle class="lost-star" cx="52" cy="140" r="1.8" style="animation-delay:1.3s" />
          <circle class="lost-star" cx="150" cy="22" r="1.6" style="animation-delay:1.7s" />
          <circle class="lost-star" cx="96" cy="86" r="1.4" style="animation-delay:.7s" />
          <circle class="lost-star" cx="206" cy="60" r="1.5" style="animation-delay:2.1s" />
          <path class="lost-route" d="M20 158 C 70 120, 96 176, 140 138 S 220 96, 300 118" fill="none" />
          <g class="lost-orbit">
            <g class="lost-satellite">
              <rect x="-13" y="-6" width="26" height="12" rx="3" fill="#8fa8d8" />
              <rect x="-19" y="-3.5" width="6" height="7" rx="1.5" fill="#6f86c4" />
              <rect x="13" y="-3.5" width="6" height="7" rx="1.5" fill="#6f86c4" />
              <circle cx="0" cy="0" r="2.2" fill="#f5e6a8" />
            </g>
          </g>
          <circle class="lost-planet" cx="170" cy="108" r="34" fill="#9a83ff" />
          <ellipse cx="170" cy="108" rx="52" ry="13" fill="none" stroke="#c9b8ff" stroke-width="4" transform="rotate(-18 170 108)" />
          <circle cx="158" cy="98" r="5" fill="#ffffff33" />
          <circle cx="182" cy="120" r="7" fill="#ffffff26" />
          <circle cx="170" cy="88" r="3" fill="#ffffff2e" />
          <g class="lost-bubble">
            <rect x="196" y="34" width="46" height="34" rx="12" fill="#ffffff" stroke="#d9cffb" stroke-width="2" />
            <path d="M210 66 l-4 10 l14 -8 z" fill="#ffffff" stroke="#d9cffb" stroke-width="2" />
            <text x="219" y="58" text-anchor="middle" font-size="20" font-weight="700" fill="#8a6fe8">?</text>
          </g>
        </svg>
      </div>
      <p>404 · STORY NOT FOUND</p>
      <h2 class="mt-4">这个故事，暂时迷路了</h2>
      <p>页面可能已搬家。别急，在路上先看一部同好都在追的番剧吧——</p>
      <div class="lost-404__pick" data-lost-pick hidden>
        <a data-lost-link href="/" class="lost-404__card">
          <img data-lost-cover src="/brand/bllii-symbol.svg" alt="" />
          <div>
            <h3 data-lost-name>随机推荐</h3>
            <p data-lost-meta>bllii</p>
            <span class="lost-404__go">去看这部 →</span>
          </div>
        </a>
        <button type="button" class="brand-outline lost-404__shuffle" data-lost-shuffle>换一部 ↻</button>
      </div>
      <a href="/" class="brand-button mt-6">回到首页 →</a>
    </div>
  </div>
</Layout>

<script type="application/json" id="lost-candidates" set:html={JSON.stringify(candidates)} />

<script>
  interface Candidate { id: number; name: string; picture: string; year: string; remarks: string }
  const candidates: Candidate[] = JSON.parse(document.getElementById('lost-candidates')?.textContent || '[]');
  const pick = document.querySelector<HTMLElement>('[data-lost-pick]');
  if (pick && candidates.length) {
    const link = pick.querySelector<HTMLAnchorElement>('[data-lost-link]')!;
    const cover = pick.querySelector<HTMLImageElement>('[data-lost-cover]')!;
    const name = pick.querySelector<HTMLElement>('[data-lost-name]')!;
    const meta = pick.querySelector<HTMLElement>('[data-lost-meta]')!;
    const shuffle = pick.querySelector<HTMLButtonElement>('[data-lost-shuffle]')!;
    let current = -1;
    const show = () => {
      let index = Math.floor(Math.random() * candidates.length);
      if (candidates.length > 1) while (index === current) index = Math.floor(Math.random() * candidates.length);
      current = index;
      const anime = candidates[index];
      link.href = `/anime/${anime.id}`;
      cover.src = anime.picture || '/brand/bllii-symbol.svg';
      cover.alt = anime.name;
      name.textContent = anime.name;
      meta.textContent = [anime.year, anime.remarks].filter(Boolean).join(' · ') || '同好都在追';
      pick.classList.remove('lost-404__pick-in');
      void pick.offsetWidth; // 重新触发入场动画
      pick.classList.add('lost-404__pick-in');
    };
    shuffle.addEventListener('click', show);
    pick.hidden = false;
    show();
  }
</script>

<style>
  .lost-404__scene { width: min(320px, 78vw); margin: 0 auto 6px; }
  .lost-404__art { display: block; width: 100%; height: auto; overflow: visible; }
  .lost-404__scene { animation: lostFloat 5s ease-in-out infinite; }
  .lost-star { fill: #b7a5f0; animation: lostTwinkle 2.4s ease-in-out infinite; }
  .lost-route { stroke: #c4b5f0; stroke-width: 2.5; stroke-dasharray: 7 9; stroke-linecap: round; animation: lostMarch 2.8s linear infinite; }
  .lost-orbit { transform-origin: 170px 108px; animation: lostSpin 9s linear infinite; }
  .lost-satellite { animation: lostBob 2.6s ease-in-out infinite; }
  .lost-planet { animation: lostBob 4.5s ease-in-out infinite; }
  .lost-bubble { transform-box: fill-box; transform-origin: 50% 100%; animation: lostBubble 3.2s ease-in-out infinite; }
  .lost-404__pick { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 14px; margin-top: 22px; }
  .lost-404__pick[hidden] { display: none; }
  .lost-404__card { display: flex; align-items: center; gap: 14px; max-width: 340px; padding: 12px 18px 12px 12px; border: 1px solid #ece7fa; border-radius: 14px; background: #fff; box-shadow: 0 6px 22px #7d88aa14; text-align: left; transition: transform .2s, box-shadow .2s; }
  .lost-404__card:hover { transform: translateY(-2px); box-shadow: 0 10px 28px #7d88aa24; }
  .lost-404__card img { width: 58px; height: 58px; flex: none; border-radius: 10px; object-fit: cover; background: #eef2fd; }
  .lost-404__card h3 { font-size: 14px; font-weight: 650; color: #353b58; }
  .lost-404__card p { font-size: 11px; color: #99a2be; margin: 3px 0 6px; }
  .lost-404__go { font-size: 11px; font-weight: 600; color: #9271d9; }
  .lost-404__shuffle { padding: 9px 18px; font-size: 12px; }
  .lost-404__pick-in .lost-404__card { animation: lostCardIn .35s cubic-bezier(.2,.7,.2,1); }
  @keyframes lostFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @keyframes lostTwinkle { 0%,100% { opacity: .25; } 50% { opacity: 1; } }
  @keyframes lostMarch { to { stroke-dashoffset: -32; } }
  @keyframes lostSpin { to { transform: rotate(360deg); } }
  @keyframes lostBob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
  @keyframes lostBubble { 0%,100% { transform: scale(1) rotate(0deg); } 50% { transform: scale(1.07) rotate(3deg); } }
  @keyframes lostCardIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .lost-404__scene, .lost-star, .lost-route, .lost-orbit, .lost-satellite, .lost-planet, .lost-bubble, .lost-404__pick-in .lost-404__card { animation: none; }
  }
</style>
