---
import BrandIcon from '../components/BrandIcon.astro';
import Layout from '../layouts/Layout.astro';
import { getVideos } from '../lib/api';

const { list, total } = await getVideos({ page: 1, pageSize: 24, typeId: 4 });
const totalDbCount = total || 6686;
---

<Layout title="番剧搜索 - bllii" activeNav="首页">
  <div class="max-w-[1360px] mx-auto px-4 sm:px-6 pt-6 pb-16">
    <!-- 居中大搜索框 -->
    <div class="max-w-2xl mx-auto mb-8 text-center space-y-4">
      
      <div class="relative">
        <input
          id="search-input"
          type="text"
          autocomplete="off"
          placeholder="请输入想看的番剧名称、角色或声优..."
          class="w-full h-12 pl-5 pr-28 rounded-full bg-white text-sm text-slate-800 shadow-sm border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-[#597bea] transition-all"
        />
        <button
          id="search-btn"
          class="absolute right-1.5 top-1.5 bottom-1.5 px-6 rounded-full bg-[#597bea] hover:bg-blue-600 text-white text-sm font-semibold transition-colors cursor-pointer"
        >
          搜索
        </button>
        <!-- 自动补全下拉 -->
        <div
          id="search-suggest"
          role="listbox"
          aria-label="搜索建议"
          class="hidden absolute left-0 right-0 top-14 mt-1 bg-white rounded-2xl border border-slate-100 shadow-lg overflow-hidden text-left z-20"
        >
        </div>
      </div>

      <!-- 个人搜索历史 -->
      <div id="search-history" class="hidden items-center justify-center gap-2 text-xs text-slate-400 flex-wrap">
        <span>历史：</span>
        <span id="search-history-list" class="inline-flex items-center gap-2 flex-wrap justify-center"></span>
        <button id="search-history-clear" class="text-slate-300 hover:text-red-500 transition-colors cursor-pointer">清空</button>
      </div>

      <!-- 热搜词 (根据真实动漫数据) -->
      <div class="flex items-center justify-center gap-2 text-xs text-slate-400 flex-wrap">
        <span>热搜：</span>
        {list.slice(0, 6).map((anime) => (
          <button class="text-slate-600 hover:text-primary-600 hover:underline search-tag-btn cursor-pointer" data-kw={anime.name}>
            {anime.name}
          </button>
        ))}
      </div>
    </div>

    <!-- 搜索结果统计条 -->
    <div class="flex items-center justify-between text-xs text-slate-400 mb-4">
      <div id="results-count">全部收录作品 (<span class="text-[#597bea] font-bold">{totalDbCount.toLocaleString()}</span> 部)：</div>
      <div id="searching-status" class="hidden text-[#597bea] font-medium flex items-center gap-1.5">
        <picture><source media="(prefers-reduced-motion: reduce)" srcset="/brand/bllii-symbol.svg" /><img src="/brand/bllii-loading.svg" width="48" height="48" alt="正在加载" /></picture>
        <span>正在全库检索中...</span>
      </div>
    </div>

    <!-- 搜索结果卡片网格 (真实数据驱动) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 min-h-[300px]" id="video-grid">
      {list.map((anime, idx) => (
        <a 
          href={`/play/${anime.id}`} 
          class="anime-item group flex flex-col card-hover-effect"
          data-track="video_click"
          data-track-id={anime.id}
          data-track-rank={idx + 1}
          data-track-expose
        >
          <div class="relative aspect-[3/4] w-full rounded-2xl overflow-hidden bg-slate-200 shadow-sm group-hover:shadow-md transition-shadow">
            <img src={anime.picture || '/brand/bllii-app-blue.svg'} alt={anime.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.onerror=null;this.src='/brand/bllii-app-blue.svg'" />
            {anime.remarks && <span class="absolute top-2 right-2 px-2 py-0.5 rounded-full text-[11px] font-medium bg-[#597bea] text-white backdrop-blur-sm">
              {anime.remarks}
            </span>}
          </div>
          <div class="mt-2.5 px-0.5">
            <h3 class="text-sm font-semibold text-slate-800 group-hover:text-primary-600 transition-colors line-clamp-1">{anime.name}</h3>
            <p class="text-xs text-slate-400 mt-0.5 line-clamp-1">{anime.actor || anime.type_name || '动漫'}</p>
          </div>
        </a>
      ))}
    </div>

    <!-- 无结果空状态 -->
    <div id="no-results" class="hidden py-16 text-center space-y-3">
      <div class="w-16 h-16 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
        <BrandIcon name="search" size={32} class="w-8 h-8" />
      </div>
      <h3 class="text-base font-bold text-slate-700">未找到符合搜索条件的番剧</h3>
      <p class="text-xs text-slate-400">您可以尝试缩短关键词，或前往番剧库按类型探索</p>
      <a href="/category" class="inline-block px-5 py-2 rounded-full bg-[#597bea] text-white text-xs font-semibold shadow-sm hover:bg-blue-600 transition-colors">
        前往番剧库
      </a>
    </div>

  </div>

  <script is:inline define:vars={{ totalDbCount }}>
    (function () {
      var HISTORY_KEY = 'bllii_search_history';
      var HISTORY_MAX = 20;

      const input = document.getElementById('search-input');
      const btn = document.getElementById('search-btn');
      const grid = document.getElementById('video-grid');
      const countEl = document.getElementById('results-count');
      const statusEl = document.getElementById('searching-status');
      const noResultsEl = document.getElementById('no-results');
      const suggestBox = document.getElementById('search-suggest');
      const historyBox = document.getElementById('search-history');
      const historyList = document.getElementById('search-history-list');
      const historyClear = document.getElementById('search-history-clear');

      /* ---------------- 个人搜索历史 (localStorage) ---------------- */
      function loadHistory() {
        try {
          const raw = localStorage.getItem(HISTORY_KEY);
          const arr = raw ? JSON.parse(raw) : [];
          return Array.isArray(arr) ? arr.filter(x => x && typeof x.kw === 'string') : [];
        } catch (e) { return []; }
      }
      function saveHistory(list) {
        try { localStorage.setItem(HISTORY_KEY, JSON.stringify(list.slice(0, HISTORY_MAX))); } catch (e) { /* ignore */ }
      }
      function rememberKeyword(kw) {
        kw = (kw || '').trim();
        if (!kw) return;
        const list = loadHistory().filter(x => x.kw !== kw);
        list.unshift({ kw: kw, ts: Date.now() });
        saveHistory(list);
        renderHistory();
      }
      function renderHistory() {
        if (!historyBox || !historyList) return;
        const list = loadHistory();
        if (!list.length) { historyBox.classList.add('hidden'); historyBox.classList.remove('flex'); return; }
        historyBox.classList.remove('hidden');
        historyBox.classList.add('flex');
        historyList.innerHTML = list.map(x =>
          `<span class="inline-flex items-center gap-0.5 rounded-full bg-white border border-slate-200 pl-2.5 pr-1 py-0.5">
            <button class="text-slate-600 hover:text-primary-600 transition-colors cursor-pointer search-history-btn" data-kw="${escapeHtml(x.kw)}">${escapeHtml(x.kw)}</button>
            <button class="text-slate-300 hover:text-red-500 transition-colors px-1 cursor-pointer search-history-del" data-kw="${escapeHtml(x.kw)}" aria-label="删除该历史">×</button>
          </span>`
        ).join('');
        historyList.querySelectorAll('.search-history-btn').forEach(b =>
          b.addEventListener('click', () => { const kw = b.getAttribute('data-kw'); if (input) input.value = kw; doSearch(kw); }));
        historyList.querySelectorAll('.search-history-del').forEach(b =>
          b.addEventListener('click', () => {
            const kw = b.getAttribute('data-kw');
            saveHistory(loadHistory().filter(x => x.kw !== kw));
            renderHistory();
          }));
      }
      historyClear?.addEventListener('click', () => { saveHistory([]); renderHistory(); });

      /* ---------------- 自动补全建议 ---------------- */
      var suggestTimer = null;
      var suggestItems = [];
      var suggestIndex = -1;

      function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/[&<>"']/g, function (m) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
        });
      }
      function hideSuggest() {
        if (suggestBox) { suggestBox.classList.add('hidden'); suggestBox.innerHTML = ''; }
        suggestItems = [];
        suggestIndex = -1;
      }
      function renderSuggest(keyword, items) {
        if (!suggestBox) return;
        suggestItems = items;
        suggestIndex = -1;
        if (!items.length) { hideSuggest(); return; }
        suggestBox.innerHTML = items.map((name, i) =>
          `<button type="button" role="option" aria-selected="false" data-suggest-index="${i}"
            class="w-full flex items-center gap-2.5 px-4 py-2.5 text-left text-sm text-slate-700 hover:bg-slate-50 transition-colors">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-300 shrink-0"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <span class="truncate">${escapeHtml(name)}</span>
          </button>`
        ).join('');
        suggestBox.classList.remove('hidden');
        suggestBox.querySelectorAll('[data-suggest-index]').forEach(b =>
          b.addEventListener('click', () => {
            const name = items[parseInt(b.getAttribute('data-suggest-index'), 10)];
            if (input) input.value = name;
            doSearch(name);
          }));
      }
      function highlightSuggest() {
        if (!suggestBox) return;
        suggestBox.querySelectorAll('[data-suggest-index]').forEach((b, i) => {
          const active = i === suggestIndex;
          b.setAttribute('aria-selected', active ? 'true' : 'false');
          b.classList.toggle('bg-blue-50', active);
          b.classList.toggle('text-primary-700', active);
        });
      }
      async function fetchSuggest(q) {
        if (!q || !q.trim()) { hideSuggest(); return; }
        try {
          const res = await fetch(`/api/search/suggest?keyword=${encodeURIComponent(q.trim())}&limit=8`);
          const json = await res.json();
          const items = (json && json.data && json.data.suggestions) || [];
          renderSuggest(q, items);
        } catch (e) { hideSuggest(); }
      }
      input?.addEventListener('input', () => {
        clearTimeout(suggestTimer);
        const q = input.value || '';
        if (!q.trim()) { hideSuggest(); return; }
        suggestTimer = setTimeout(() => fetchSuggest(q), 180);
      });
      input?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          if (!suggestItems.length) return;
          e.preventDefault();
          suggestIndex += (e.key === 'ArrowDown' ? 1 : -1);
          if (suggestIndex < 0) suggestIndex = suggestItems.length - 1;
          if (suggestIndex >= suggestItems.length) suggestIndex = 0;
          highlightSuggest();
        } else if (e.key === 'Enter') {
          if (suggestIndex >= 0 && suggestItems[suggestIndex]) {
            e.preventDefault();
            const name = suggestItems[suggestIndex];
            if (input) input.value = name;
            doSearch(name);
          } else {
            doSearch(input.value);
          }
        } else if (e.key === 'Escape') {
          hideSuggest();
        }
      });
      document.addEventListener('click', (e) => {
        if (suggestBox && !suggestBox.contains(e.target) && e.target !== input) hideSuggest();
      });

      /* ---------------- 搜索主流程 ---------------- */
      async function doSearch(kw) {
        const q = (kw || '').trim();
        hideSuggest();
        if (!q) {
          window.location.href = '/search';
          return;
        }

        if (statusEl) statusEl.classList.remove('hidden');
        if (noResultsEl) noResultsEl.classList.add('hidden');

        // 上报站内搜索事件
        if ((window as any).blliiTrack) {
          (window as any).blliiTrack.event('search', { keyword: q });
        }

        try {
          const res = await fetch(`/api/videos?type_id=4&keyword=${encodeURIComponent(q)}&page=1&page_size=48`);
          const json = await res.json();
          const items = (json && json.data) ? json.data : [];
          const total = (json && json.total !== undefined) ? json.total : items.length;

          if (countEl) {
            countEl.innerHTML = `找到关于 "<strong class="text-slate-800">${escapeHtml(q)}</strong>" 的番剧共 <strong class="text-[#597bea] font-bold">${total}</strong> 部 (全库 ${totalDbCount.toLocaleString()}+ 部)：`;
          }

          if (items.length === 0) {
            grid.innerHTML = '';
            if (noResultsEl) noResultsEl.classList.remove('hidden');
          } else {
            if (noResultsEl) noResultsEl.classList.add('hidden');
            grid.innerHTML = items.map((anime, idx) => `
              <a 
                href="/play/${anime.id}" 
                class="anime-item group flex flex-col card-hover-effect"
                data-track="video_click"
                data-track-id="${anime.id}"
                data-track-rank="${idx + 1}"
                data-track-keyword="${escapeHtml(q)}"
                data-track-expose
              >
                <div class="relative aspect-[3/4] w-full rounded-2xl overflow-hidden bg-slate-200 shadow-sm group-hover:shadow-md transition-shadow">
                  <img 
                    src="${escapeHtml(anime.picture) || '/brand/bllii-app-blue.svg'}" 
                    alt="${escapeHtml(anime.name)}" 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                    onerror="this.onerror=null;this.src='/brand/bllii-app-blue.svg'" 
                  />
                  ${anime.remarks ? `<span class="absolute top-2 right-2 px-2 py-0.5 rounded-full text-[11px] font-medium bg-[#597bea] text-white backdrop-blur-sm">
                    ${escapeHtml(anime.remarks)}
                  </span>` : ''}
                </div>
                <div class="mt-2.5 px-0.5">
                  <h3 class="text-sm font-semibold text-slate-800 group-hover:text-primary-600 transition-colors line-clamp-1">${escapeHtml(anime.name)}</h3>
                  <p class="text-xs text-slate-400 mt-0.5 line-clamp-1">${escapeHtml(anime.actor || anime.type_name || '动漫')}</p>
                </div>
              </a>
            `).join('');
          }

          // 记录个人搜索历史 + 埋点
          rememberKeyword(q);
          if (window.blliiTrack) window.blliiTrack.event('search', { keyword: q });

          // 同步 URL 参数
          const nextUrl = new URL(window.location.href);
          nextUrl.searchParams.set('q', q);
          window.history.replaceState({}, '', nextUrl.toString());
        } catch (e) {
          console.error('[Search API Error]', e);
        } finally {
          if (statusEl) statusEl.classList.add('hidden');
        }
      }

      btn?.addEventListener('click', () => doSearch(input?.value));
      // Enter 搜索在 keydown 中处理（支持键盘选择补全项），此处无需重复监听

      document.querySelectorAll('.search-tag-btn').forEach(b => {
        b.addEventListener('click', () => {
          const kw = b.getAttribute('data-kw');
          if (input) input.value = kw;
          doSearch(kw);
        });
      });

      // 初始化：渲染历史 + 处理 URL 中的 q 参数
      renderHistory();
      const params = new URLSearchParams(window.location.search);
      const qParam = params.get('q');
      if (qParam && input) {
        input.value = qParam;
        doSearch(qParam);
      }
    })();
  </script>
</Layout>
