---
import Layout from '../layouts/Layout.astro';
import { getAnimeVideos } from '../lib/api';

// 初始渲染推荐追番动画 (真实动漫作品)
const defaultAnime = await getAnimeVideos(8);
---

<Layout title="追番列表与我的收藏 - bllii" activeNav="追番">
  <div class="max-w-[1360px] mx-auto px-4 sm:px-6 pt-6 pb-16">
    
    <!-- 顶部状态栏 -->
    <div class="mb-6 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          
          <p id="user-greeting" class="text-xs text-slate-400 mt-1">云端多设备实时同步播放记录与追番状态</p>
        </div>

        <!-- 未登录引导登录横幅 (未登录时显示) -->
        <div id="login-prompt-banner" class="hidden items-center gap-3 px-4 py-2 rounded-2xl bg-blue-50 border border-blue-200/60 shadow-sm text-xs">
          <span class="text-slate-600">当前处于未登录访客模式</span>
          <a href="/login?redirect=/follow" class="px-3 py-1 rounded-full bg-[#597bea] text-white font-semibold hover:bg-blue-600 transition-colors shadow-sm">
            立即登录同步
          </a>
        </div>
      </div>

      <!-- Tab 切换按钮 -->
      <div class="flex items-center gap-2.5">
        <button id="tab-following" type="button" class="px-4 py-1.5 rounded-full bg-[#597bea] text-white text-xs font-semibold shadow-sm cursor-pointer transition-all">
          正在追番 (<span id="following-count">{defaultAnime.length}</span>)
        </button>
        <button id="tab-history" type="button" class="px-4 py-1.5 rounded-full bg-white text-slate-600 hover:bg-slate-100 text-xs font-semibold ring-1 ring-slate-200 cursor-pointer transition-all">
          观看历史 (<span id="history-count">0</span>)
        </button>
      </div>
    </div>

    <!-- 1. 正在追番列表容器 -->
    <div id="container-following">
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4" id="following-grid">
        {defaultAnime.map((anime) => (
          <a href={`/play/${anime.id}`} class="anime-card group flex flex-col card-hover-effect">
            <div class="relative aspect-[3/4] w-full rounded-2xl overflow-hidden bg-slate-200 shadow-sm group-hover:shadow-md transition-shadow">
              <img src={anime.picture || '/brand/bllii-app-blue.svg'} alt={anime.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.onerror=null;this.src='/brand/bllii-app-blue.svg'" />
              <span class="absolute top-2 right-2 px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-600/90 text-white backdrop-blur-sm shadow-sm">
                追番中
              </span>
            </div>
            <div class="mt-2.5 px-0.5">
              <h3 class="text-sm font-semibold text-slate-800 group-hover:text-primary-600 transition-colors line-clamp-1">{anime.name}</h3>
              <p class="text-xs text-slate-400 mt-0.5">{anime.remarks || '看到最新话'}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- 2. 观看历史列表容器 (初始隐藏) -->
    <div id="container-history" class="hidden">
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4" id="history-grid">
        <!-- 动态由客户端从 /api/user/history 渲染 -->
      </div>
      <div id="history-empty" class="py-16 text-center space-y-3">
        <div class="w-16 h-16 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-slate-700">暂无观看历史</h3>
        <p class="text-xs text-slate-400">快去发现并播放你喜爱的番剧吧</p>
        <a href="/category" class="inline-block px-5 py-2 rounded-full bg-[#597bea] text-white text-xs font-semibold shadow-sm hover:bg-blue-600 transition-colors">
          探索热门番剧
        </a>
      </div>
    </div>

  </div>

  <script>
    import { getUser, getFavorites, getHistory } from '../lib/auth';

    const tabFollowing = document.getElementById('tab-following');
    const tabHistory = document.getElementById('tab-history');
    const containerFollowing = document.getElementById('container-following');
    const containerHistory = document.getElementById('container-history');
    const historyGrid = document.getElementById('history-grid');
    const historyEmpty = document.getElementById('history-empty');
    const historyCount = document.getElementById('history-count');
    const followingCount = document.getElementById('following-count');
    const loginPrompt = document.getElementById('login-prompt-banner');
    const greetingEl = document.getElementById('user-greeting');

    async function initUserFollowData() {
      const user = getUser();
      if (user && user.username) {
        if (loginPrompt) loginPrompt.classList.add('hidden');
        if (greetingEl) greetingEl.textContent = `你好，${user.nickname || user.username}！已为您同步云端追番与历史记录。`;
        
        // 拉取后端真实追番收藏
        const favs = await getFavorites();
        if (favs && favs.length > 0) {
          if (followingCount) followingCount.textContent = String(favs.length);
        }

        // 拉取后端真实播放历史
        const hist = await getHistory();
        if (hist && historyCount) {
          historyCount.textContent = String(hist.length);
        }
        if (hist && hist.length > 0 && historyGrid) {
          historyGrid.innerHTML = hist.map(item => {
            // 智能提取 0-based 集数索引
            let epIdx = 0;
            if (typeof item.episode_index === 'number' && item.episode_index >= 0) {
              epIdx = item.episode_index;
            } else if (item.episode_name) {
              const m = item.episode_name.match(/(\d+)/);
              if (m) {
                epIdx = Math.max(0, parseInt(m[1], 10) - 1);
              }
            }

            const epName = item.episode_name || `第${epIdx + 1}集`;

            return `
            <a href="/play/${item.video_id}?ep=${epIdx}" class="group flex flex-col card-hover-effect">
              <div class="relative aspect-[3/4] w-full rounded-2xl overflow-hidden bg-slate-200 shadow-sm group-hover:shadow-md transition-shadow">
                <img src="${item.picture || '/brand/bllii-app-blue.svg'}" alt="${item.video_name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.onerror=null;this.src='/brand/bllii-app-blue.svg'" />
                <span class="absolute bottom-2 right-2 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-[#597bea] text-white backdrop-blur-sm shadow-sm">
                  ${epName}
                </span>
              </div>
              <div class="mt-2.5 px-0.5">
                <h3 class="text-sm font-semibold text-slate-800 group-hover:text-primary-600 transition-colors line-clamp-1">${item.video_name}</h3>
                <p class="text-xs text-slate-400 mt-0.5">看到 ${epName} · 点击续播</p>
              </div>
            </a>
          `;
          }).join('');
          historyEmpty?.classList.add('hidden');
        } else {
          historyEmpty?.classList.remove('hidden');
        }
      } else {
        if (loginPrompt) loginPrompt.classList.remove('hidden');
        if (loginPrompt) loginPrompt.classList.add('flex');
      }
    }

    tabFollowing?.addEventListener('click', () => {
      tabFollowing.className = 'px-4 py-1.5 rounded-full bg-[#597bea] text-white text-xs font-semibold shadow-sm cursor-pointer transition-all';
      tabHistory!.className = 'px-4 py-1.5 rounded-full bg-white text-slate-600 hover:bg-slate-100 text-xs font-semibold ring-1 ring-slate-200 cursor-pointer transition-all';
      containerFollowing?.classList.remove('hidden');
      containerHistory?.classList.add('hidden');
    });

    tabHistory?.addEventListener('click', () => {
      tabHistory.className = 'px-4 py-1.5 rounded-full bg-[#597bea] text-white text-xs font-semibold shadow-sm cursor-pointer transition-all';
      tabFollowing!.className = 'px-4 py-1.5 rounded-full bg-white text-slate-600 hover:bg-slate-100 text-xs font-semibold ring-1 ring-slate-200 cursor-pointer transition-all';
      containerHistory?.classList.remove('hidden');
      containerFollowing?.classList.add('hidden');
    });

    // 检查 URL 是否带 tab=history
    if (new URLSearchParams(window.location.search).get('tab') === 'history') {
      tabHistory?.click();
    }

    initUserFollowData();
  </script>
</Layout>
