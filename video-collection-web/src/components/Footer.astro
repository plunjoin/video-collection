---
import { getSiteConfig } from "../lib/api";

const config = await getSiteConfig();
const friendLinks = config.friend_links || [];
---

<footer
  class="border-t border-slate-200/80 bg-white/95 backdrop-blur-md pt-12 pb-8 text-xs text-slate-500 mt-16 transition-colors"
>
  <div class="max-w-[1360px] mx-auto px-4 sm:px-6">
    <!-- 上层主网格：品牌简介、官方联系方式、友情链接 -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 pb-10 border-b border-slate-100"
    >
      <!-- 栏目 1：品牌标识与平台定位 (占 4 列) -->
      <div class="lg:col-span-4 flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <img
            src="/brand/bllii-horizontal.svg"
            alt="bllii"
            width="140"
            height="54"
          />
          <span class="sr-only" id="footer-site-name">
            {config.site_name || "bllii 动漫聚合"}
          </span>
        </div>
        <p
          class="text-slate-500 leading-relaxed text-xs sm:text-[13px] mt-1 pr-4"
          id="footer-site-subtitle"
        >
          {
            config.site_subtitle || "追番库 • 让生活多一种可能"
          }。精选全网正版与优质二次元动漫、剧场版及新番流媒体资源，智能聚合秒播，致力于为动漫爱好者提供极速舒适的追番体验。
        </p>
        <div class="flex items-center gap-3 mt-2 text-slate-400">
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-600 font-medium text-[11px]"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"
            ></span>
            极光画质引擎运行中
          </span>
          <span
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-primary-50 text-primary-600 font-medium text-[11px]"
          >
            智能同系列推荐
          </span>
        </div>
      </div>

      <!-- 栏目 2：联系方式 (后台可控) (占 4 列) -->
      <div class="lg:col-span-4 flex flex-col gap-3">
        <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
          <svg
            class="w-4 h-4 text-primary-600"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <span>联系方式</span>
        </h3>

        <ul class="space-y-2.5 text-xs text-slate-600" id="footer-contact-list">
          <!-- 联系邮箱 -->
          <li class="flex items-center gap-2 group">
            <span class="text-slate-400 shrink-0">联系邮箱：</span>
            <a
              id="footer-contact-email"
              href={config.site_contact_email ? `mailto:${config.site_contact_email}` : undefined}
              class="text-primary-600 hover:text-primary-700 font-medium hover:underline transition-colors truncate"
            >
              {config.site_contact_email || "暂未设置"}
            </a>
          </li>

          <!-- 官方社群 / 交流群 / 联系方式 -->
          <li class="flex items-center gap-2">
            <span class="text-slate-400 shrink-0">官方社群：</span>
            <span
              id="footer-contact-group"
              class="text-slate-700 font-medium truncate"
            >
              {config.site_contact_group || "暂未设置"}
            </span>
          </li>

          <li class="pt-1">
            <a
              href="/community"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-primary-50 text-primary-600 hover:bg-primary-100 font-medium text-xs transition-colors"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                ></path>
              </svg>
              <span>前往留言求片反馈</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- 栏目 3：友情链接 (后台可控) (占 4 列) -->
      <div class="lg:col-span-4 flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
            <svg
              class="w-4 h-4 text-primary-600"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
              ></path>
            </svg>
            <span>友情链接</span>
          </h3>
        </div>

        <!-- 友链标签矩阵 -->
        <div
          class="flex flex-wrap gap-2 pt-1"
          id="footer-friend-links-container"
        >
          {friendLinks.length === 0 && <span class="text-slate-400">暂无友情链接</span>}
          {
            friendLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                title={link.description || link.name}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-primary-50 text-slate-600 hover:text-primary-600 border border-transparent hover:border-primary-100 text-xs font-medium transition-all group"
              >
                <span>{link.name}</span>
                <svg
                  class="w-3 h-3 text-slate-400 group-hover:text-primary-500 opacity-60 group-hover:opacity-100 transition-opacity"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- 中层：平台免责声明条 (版权合规与法律保护) -->

    <div class="flex-1 space-y-1">
      <p
        id="footer-disclaimer-text"
        class="text-slate-600 leading-relaxed text-xs"
      >
        {
          config.site_disclaimer ||
            "本站所有视频资源均系第三方公开网络接口与网络爬虫自动检索聚合，本站服务器不存储、不制作、不上传任何视听节目及视频文件。若相关内容无意侵犯了贵司版权或合法权益，请通过上方联系方式提供权利证明与侵权链接，我们将在收到通知后24小时内断开相关播放解析并配合清理。本站提倡支持正版影视与动漫。"
        }
      </p>
    </div>
    <div class="brand-masthead">
      <a href="/" aria-label="bllii 首页">
        <!-- <img src="/brand/bllii-horizontal.svg" alt="bllii" /> -->
      </a>
      <p>
        好 动 画 · 更 好 的 你<small>SAME STORIES. A BRIGHTER YOU.</small>
      </p>
    </div>
    <!-- 下层：快捷版权与服务条款 -->
    <div
      class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 text-slate-400 text-xs"
    >
      <div class="flex items-center gap-3 flex-wrap">
        <span>© 2026 bllii • 二次元番剧聚合平台</span>
      </div>
      <div class="flex items-center gap-4 text-slate-500">
        <a href="/community" class="hover:text-primary-600 transition-colors"
          >留言求片</a
        >
        <a href="#" class="hover:text-primary-600 transition-colors">用户协议</a
        >
        <a href="#" class="hover:text-primary-600 transition-colors">隐私保护</a
        >
        <a href="#" class="hover:text-primary-600 transition-colors">版权申明</a
        >
      </div>
    </div>
  </div>
</footer>

<!-- 客户端实时更新脚本：确保后台修改配置后无需重构网站即可秒级同步刷新 -->
<script is:inline>
  window.addEventListener("DOMContentLoaded", async () => {
    try {
      const res = await fetch("/api/site/config");
      if (!res.ok) return;
      const json = await res.json();
      if (json && json.code === 1 && json.data) {
        const d = json.data;
        // 动态更新官方联系方式
        if (d.site_contact_email) {
          const emailEl = document.getElementById("footer-contact-email");
          if (emailEl) {
            emailEl.textContent = d.site_contact_email;
            emailEl.setAttribute("href", "mailto:" + d.site_contact_email);
          }
        }
        if (d.site_contact_group) {
          const grpEl = document.getElementById("footer-contact-group");
          if (grpEl) grpEl.textContent = d.site_contact_group;
        }
        // 动态更新免责声明
        if (d.site_disclaimer) {
          const discEl = document.getElementById("footer-disclaimer-text");
          if (discEl) discEl.textContent = d.site_disclaimer;
        }
        // 动态更新友情链接
        if (d.site_friend_links) {
          try {
            const links = JSON.parse(d.site_friend_links);
            if (Array.isArray(links) && links.length > 0) {
              const container = document.getElementById(
                "footer-friend-links-container",
              );
              if (container) {
                container.innerHTML = links
                  .map(
                    (link) => `
                  <a
                    href="${link.url}"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="${link.description || link.name}"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-primary-50 text-slate-600 hover:text-primary-600 border border-transparent hover:border-primary-100 text-xs font-medium transition-all group"
                  >
                    <span>${link.name}</span>
                    <svg class="w-3 h-3 text-slate-400 group-hover:text-primary-500 opacity-60 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                `,
                  )
                  .join("");
              }
            }
          } catch (e) {}
        }
      }
    } catch (e) {
      // 忽略异常，使用 SSR 渲染内容兜底
    }
  });
</script>
