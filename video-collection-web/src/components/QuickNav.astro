---
// 5大核心快捷入口金刚区 (新番时间表、排行榜、专属合集、追番列表、我的收藏)
const items = [
  {
    name: '新番时间表',
    iconBg: 'bg-blue-100 text-blue-600',
    href: '/latest',
    svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`
  },
  {
    name: '排行榜',
    iconBg: 'bg-pink-100 text-pink-600',
    href: '/rank',
    svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />`
  },
  {
    name: '专属合集',
    iconBg: 'bg-purple-100 text-purple-600',
    href: '/category',
    svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`
  },
  {
    name: '追番列表',
    iconBg: 'bg-blue-100 text-blue-500',
    href: '/follow',
    svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />`
  },
  {
    name: '我的收藏',
    iconBg: 'bg-pink-100 text-pink-500',
    href: '/follow?tab=favorites',
    svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />`
  }
];
---

<section class="brand-section quick-nav">
  <div class="py-2">
    <div class="grid grid-cols-5 gap-2 sm:gap-6">
      {items.map((item) => (
        <a 
          href={item.href}
          class="flex flex-col items-center justify-center gap-2 group p-1 sm:p-2 rounded-xl transition-all"
        >
          <div class={`w-11 h-11 sm:w-14 sm:h-14 rounded-2xl flex items-center justify-center ${item.iconBg} shadow-sm group-hover:scale-110 group-hover:shadow-md transition-all duration-300`}>
            <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={item.svg}>
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-medium text-slate-700 group-hover:text-primary-600 transition-colors tracking-tight text-center">
            {item.name}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
