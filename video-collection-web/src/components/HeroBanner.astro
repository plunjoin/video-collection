---
import type { VideoRecord } from '../lib/api';
import BrandIcon from './BrandIcon.astro';
interface Props { featuredVideo?: VideoRecord; videos?: VideoRecord[]; }
const { featuredVideo, videos = [] } = Astro.props;
const slides = videos.length ? videos.slice(0, 5) : featuredVideo ? [featuredVideo] : [];
---
<section class="brand-section hero-section">
  <div data-hero>
  <div class="brand-hero">
    {(slides.length ? slides : [null]).map((video, i) => (
      <div class="brand-hero__slide" data-slide hidden={i !== 0}>
        <img class="brand-hero__image" src={video?.picture || '/assets/hero_banner.jpg'} alt={video?.name || 'bllii'} loading={i === 0 ? 'eager' : 'lazy'} onerror="this.onerror=null;this.src='/assets/hero_banner.jpg'" />
        <div class="brand-hero__shade"></div>
        <div class="brand-hero__copy">
          <p class="brand-eyebrow">bllii / 今日放映 <span class="hero-story-number">{String(i + 1).padStart(2, '0')}</span></p>
          <h1>{video?.name || 'bllii · 动漫放映室'}</h1>
          <p class="brand-hero__title">{video ? [video.year, video.remarks, ...(video.tags || []).slice(0, 2)].filter(Boolean).join(' · ') : '在更多的故事里，遇见更好的你'}</p>
          <a class="brand-button" href={video ? `/play/${video.id}` : '/category'}><BrandIcon name="play" />{video ? '立即观看' : '发现番剧'}</a>
        </div>
        <span class="brand-hero__note" aria-hidden="true">MORE STORIES,<br />TOGETHER.</span>
      </div>
    ))}
    {slides.length > 1 && <>
      <button class="hero-arrow hero-arrow--prev" data-prev aria-label="上一张" title="上一张"><BrandIcon name="arrow-left" /></button>
      <button class="hero-arrow hero-arrow--next" data-next aria-label="下一张" title="下一张"><BrandIcon name="arrow-right" /></button>
    </>}
  </div>
  {slides.length > 1 && <div class="story-reel" aria-label="今日放映列表">{slides.map((video, i) => <button data-dot={i} aria-pressed={i === 0}><span class="story-reel__number">{String(i + 1).padStart(2, '0')}</span><img src={video.picture || '/assets/hero_banner.jpg'} alt="" onerror="this.onerror=null;this.src='/assets/hero_banner.jpg'" /><span>{video.name}</span></button>)}</div>}
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach(hero => {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    let current = 0;
    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.hidden = i !== current);
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) slides[current].animate([
        { clipPath: 'inset(0 48% 0 48%)', opacity: .45 }, { clipPath: 'inset(0)', opacity: 1 }
      ], { duration: 420, easing: 'cubic-bezier(.2,.7,.2,1)' });
      dots.forEach((dot, i) => dot.setAttribute('aria-pressed', String(i === current)));
    };
    hero.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    hero.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
  });
</script>
