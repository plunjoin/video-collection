---
import type { VideoRecord } from '../lib/api';
import BrandIcon from './BrandIcon.astro';
interface Props { video: VideoRecord; }
const { video } = Astro.props;
const tags = video.tags?.length ? video.tags : [video.type_name || '番剧'];
---
<section class="anime-hero">
  <div class="anime-hero__banner">
    <img src={video.picture || '/brand/bllii-app-blue.svg'} alt="" onerror="this.onerror=null;this.src='/brand/bllii-app-blue.svg'" />
    <p>即使世界再遥远<br />也会遇见喜欢的故事</p>
  </div>
  <div class="anime-hero__info">
    <img class="anime-hero__poster" src={video.picture || '/brand/bllii-app-light.svg'} alt={video.name} onerror="this.onerror=null;this.src='/brand/bllii-app-light.svg'" />
    <div>
      <h1>{video.name}</h1>
      <div class="anime-hero__tags">{tags.slice(0, 5).map(tag => <span>{tag}</span>)}</div>
      <p class="anime-hero__meta">{[video.year, video.area, video.language, video.remarks].filter(Boolean).join(' ｜ ')}</p>
      <p class="anime-hero__synopsis">{video.content}</p>
      <div class="anime-hero__actions">
        <a id="btn-hero-play" class="brand-button" href={`/play/${video.id}`}><BrandIcon name="play" /><span id="btn-hero-play-text">立即播放</span></a>
        <button id="btn-follow" class="brand-outline" data-id={video.id} data-name={video.name} data-pic={video.picture}><BrandIcon name="heart" /><span>追番</span></button>
        <button id="btn-fav" class="brand-outline" aria-label="收藏" title="收藏" data-id={video.id} data-name={video.name} data-pic={video.picture}><BrandIcon name="star" /></button>
        <button class="brand-outline" data-pocket-id={video.id} data-pocket-name={video.name} data-pocket-picture={video.picture} aria-pressed="false" aria-label="放进故事口袋" title="放进故事口袋"><BrandIcon name="bookmark" /></button>
      </div>
    </div>
  </div>
  <script>
    import { getUser, addFavorite, getFavorites, removeFavorite } from '../lib/auth';

    const btnFollow = document.getElementById('btn-follow');
    const btnFav = document.getElementById('btn-fav');
    const videoDataEl = document.querySelector('[data-video-id]');

    async function initFollowBtn() {
      const user = getUser();
      if (!user || !btnFollow) return;

      const vid = parseInt(btnFollow.getAttribute('data-id') || '0', 10);
      if (!vid) return;

      const favs = await getFavorites();
      const isFav = favs.some(f => f.video_id === vid);

      if (isFav) {
        btnFollow.innerHTML = `
          <svg class="brand-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="/brand/bllii-ui.svg#bllii-check" /></svg>
          <span>已追番</span>
        `;
        btnFollow.classList.add('bg-emerald-600/40', 'border-emerald-400/50');
      }
    }

    async function handleToggleFollow(e: Event) {
      e.preventDefault();
      const user = getUser();
      const vid = parseInt(btnFollow?.getAttribute('data-id') || '0', 10);
      const name = btnFollow?.getAttribute('data-name') || '';
      const pic = btnFollow?.getAttribute('data-pic') || '';

      if (!user) {
        window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
        return;
      }

      if (!vid) return;

      const favs = await getFavorites();
      const existing = favs.find(f => f.video_id === vid);

      if (existing) {
        await removeFavorite(vid);
        if (btnFollow) {
          btnFollow.innerHTML = `
            <svg class="brand-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="/brand/bllii-ui.svg#bllii-plus" /></svg>
            <span>+ 追番</span>
          `;
          btnFollow.classList.remove('bg-emerald-600/40', 'border-emerald-400/50');
        }
      } else {
        await addFavorite({ id: vid, name, picture: pic });
        if (btnFollow) {
          btnFollow.innerHTML = `
            <svg class="brand-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="/brand/bllii-ui.svg#bllii-check" /></svg>
            <span>已追番</span>
          `;
          btnFollow.classList.add('bg-emerald-600/40', 'border-emerald-400/50');
        }
      }
    }

    function initResumePlayBtn() {
      const vid = parseInt(btnFollow?.getAttribute('data-id') || '0', 10);
      if (!vid) return;
      const historyKey = `vplayer_history_${vid}`;
      try {
        const saved = JSON.parse(localStorage.getItem(historyKey) || '{}');
        if (typeof saved.episodeIndex === 'number' && saved.episodeIndex > 0) {
          const heroPlayBtn = document.getElementById('btn-hero-play');
          const playText = document.getElementById('btn-hero-play-text');
          const label = saved.episodeName || `第${saved.episodeIndex + 1}话`;
          if (heroPlayBtn) heroPlayBtn.setAttribute('href', `/play/${vid}?ep=${saved.episodeIndex}`);
          if (playText) playText.textContent = `续看 ${label}`;
        }
      } catch {}
    }

    btnFollow?.addEventListener('click', handleToggleFollow);
    btnFav?.addEventListener('click', handleToggleFollow);
    initFollowBtn();
    initResumePlayBtn();
  </script>
</section>
