---
/**
 * 为你推荐（个性化首页模块）
 * 客户端渲染：登录用户调用 /api/recommend/for-you（基于 history/favorites 标签匹配）
 * 未登录时展示登录引导；推荐点击通过 data-track 自动埋点。
 */
---
<section id="for-you" class="brand-section" data-for-you hidden>
  <div class="section-heading section-heading--wrap">
    <h2>为你推荐</h2>
    <span class="text-xs text-slate-400" data-for-you-basis></span>
  </div>
  <div class="video-grid" data-for-you-grid></div>
  <p class="brand-empty" data-for-you-empty hidden>暂时没有专属推荐。多看几部喜欢的番剧，这里就会越来越懂你。</p>
</section>
<div class="brand-section" data-for-you-hint hidden>
  <div class="for-you-hint">
    <span class="for-you-hint__text">登录后解锁「为你推荐」，首页只放你想看的</span>
    <a class="for-you-hint__action" href="/login">立即登录 →</a>
  </div>
</div>

<script>
  (async function () {
    const section = document.querySelector('[data-for-you]');
    const grid = document.querySelector('[data-for-you-grid]');
    const empty = document.querySelector('[data-for-you-empty]');
    const basis = document.querySelector('[data-for-you-basis]');
    const hint = document.querySelector('[data-for-you-hint]');
    if (!section || !grid) return;

    let token = '';
    try { token = localStorage.getItem('Bllii_token') || ''; } catch (e) { /* ignore */ }
    if (!token) {
      if (hint) hint.hidden = false;
      return;
    }

    const escapeHtml = (str) => String(str ?? '').replace(/[&<>"']/g, (m) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]
    ));

    try {
      const res = await fetch('/api/recommend/for-you?limit=12', {
        headers: { 'Authorization': 'Bearer ' + token }
      });
      const json = await res.json();
      const payload = (json && json.data) || {};
      const items = payload.items || [];
      section.hidden = false;
      if (!items.length) {
        if (empty) empty.hidden = false;
        return;
      }
      if (basis && payload.based_on && payload.based_on.length) {
        basis.textContent = '根据你的口味：' + payload.based_on.join(' / ');
      }
      grid.innerHTML = items.map((anime) => `
        <a href="/play/${anime.id}" class="anime-item group flex flex-col card-hover-effect"
           data-track="rec_click" data-track-id="${anime.id}">
          <div class="relative aspect-[3/4] w-full rounded-2xl overflow-hidden bg-slate-200 shadow-sm group-hover:shadow-md transition-shadow">
            <img
              src="${escapeHtml(anime.picture || anime.pic) || '/brand/bllii-app-blue.svg'}"
              alt="${escapeHtml(anime.name)}"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
              onerror="this.onerror=null;this.src='/brand/bllii-app-blue.svg'"
            />
            ${anime.remarks ? `<span class="absolute top-2 right-2 px-2 py-0.5 rounded-full text-[11px] font-medium bg-[#597bea] text-white backdrop-blur-sm">${escapeHtml(anime.remarks)}</span>` : ''}
          </div>
          <div class="mt-2.5 px-0.5">
            <h3 class="text-sm font-semibold text-slate-800 group-hover:text-primary-600 transition-colors line-clamp-1">${escapeHtml(anime.name)}</h3>
            <p class="text-xs text-slate-400 mt-0.5 line-clamp-1">${escapeHtml(anime.actor || anime.type_name || '动漫')}</p>
          </div>
        </a>
      `).join('');
    } catch (e) {
      // 接口异常时静默降级，不影响首页其他模块
    }
  })();
</script>

<style>
  .for-you-hint {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 14px 20px; border-radius: 16px;
    background: linear-gradient(100deg, #eef2ff 0%, #f5f3ff 60%, #fdf2f8 100%);
    border: 1px dashed #c7d2fe;
  }
  .for-you-hint__text { font-size: 13px; color: #4f46e5; font-weight: 600; }
  .for-you-hint__action {
    flex-shrink: 0; font-size: 12px; font-weight: 700; color: #fff;
    background: #597bea; border-radius: 999px; padding: 6px 14px; text-decoration: none;
    transition: background-color .2s ease;
  }
  .for-you-hint__action:hover { background: #4569d8; }
  @media (max-width: 640px) {
    .for-you-hint { flex-direction: column; text-align: center; }
  }
</style>
