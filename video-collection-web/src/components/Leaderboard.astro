---
import type { VideoRecord } from '../lib/api';

interface Props {
  topVideos: VideoRecord[];
}

const { topVideos = [] } = Astro.props;

const tabs = ['本周热门', '评分排行', '追番人数', '新番榜'];
---

<section id="rank" class="max-w-[1360px] mx-auto px-4 sm:px-6 mt-9">
  <!-- 标题与榜单筛选 Tab -->
  <div class="space-y-3 mb-4">
    <h2 class="text-xl font-bold text-slate-800 tracking-tight">排行榜</h2>
    
    <div class="flex items-center gap-2">
      {tabs.map((tab, idx) => (
        <button
          class={`px-3.5 py-1 rounded-full text-xs font-medium transition-all ${
            idx === 0
              ? 'bg-blue-50 text-[#597bea] font-semibold ring-1 ring-blue-200'
              : 'text-slate-500 hover:text-slate-700 hover:bg-slate-100'
          }`}
        >
          {tab}
        </button>
      ))}
    </div>
  </div>

  <!-- 5 列排行榜横向展示网格 (完全由接口数据驱动) -->
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3.5 sm:gap-4.5">
    {topVideos.slice(0, 5).map((anime, index) => {
      const rank = index + 1;
      let badgeClass = 'bg-slate-700/80 text-white font-medium';
      if (rank === 1) badgeClass = 'badge-gold text-white font-bold shadow-md shadow-amber-500/20';
      else if (rank === 2) badgeClass = 'badge-silver text-white font-bold';
      else if (rank === 3) badgeClass = 'badge-bronze text-white font-bold';

      return (
        <a 
          href={`/play/${anime.id}`}
          class="group flex flex-col card-hover-effect"
        >
          <!-- 封面图及角标 -->
          <div class="relative aspect-[3/4] w-full rounded-2xl overflow-hidden bg-slate-200 shadow-sm group-hover:shadow-md transition-shadow">
            <img
              src={anime.picture || '/brand/bllii-app-blue.svg'}
              alt={anime.name}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              onerror="this.onerror=null;this.src='/brand/bllii-app-blue.svg'"
            />
            
            <!-- 排名数字角标 (左上角) -->
            <div class={`absolute top-2 left-2 w-6 h-6 rounded-lg flex items-center justify-center text-xs shadow-sm ${badgeClass}`}>
              {rank}
            </div>

            <!-- 右下角连载/完结状态 -->
            <span class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded text-[10px] font-medium bg-black/55 text-white backdrop-blur-sm">
              {anime.remarks?.includes('完结') ? '完结' : '连载'}
            </span>
          </div>

          <!-- 标题与年份 -->
          <div class="mt-2.5 px-0.5">
            <h3 class="text-sm font-semibold text-slate-800 group-hover:text-primary-600 transition-colors line-clamp-1">
              {anime.name}
            </h3>
            <p class="mt-1 text-xs text-slate-400">{[anime.year, anime.area].filter(Boolean).join(' · ')}</p>
          </div>
        </a>
      );
    })}
  </div>
</section>
