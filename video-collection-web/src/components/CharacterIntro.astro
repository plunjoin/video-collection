---
interface CharacterItem {
  id: number;
  name: string;
  cv: string;
  avatar: string;
}

const DEFAULT_CHARACTERS: CharacterItem[] = [
  { id: 1, name: '芙莉莲', cv: 'CV. 种崎敦美', avatar: '/assets/char_1_frieren.jpg' },
  { id: 2, name: '欣梅尔', cv: 'CV. 冈本信彦', avatar: '/assets/char_2_himmel.jpg' },
  { id: 3, name: '菲伦', cv: 'CV. 市之濑加那', avatar: '/assets/char_3_fern.jpg' },
  { id: 4, name: '修塔尔克', cv: 'CV. 小林千晃', avatar: '/assets/char_4_stark.jpg' },
];

interface Props {
  characters?: CharacterItem[];
}

const { characters = DEFAULT_CHARACTERS } = Astro.props;
---

<section id="tab-角色" class="max-w-[1360px] mx-auto px-4 sm:px-6 mt-8">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-lg font-bold text-slate-800 tracking-tight">角色介绍</h2>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 sm:gap-4">
    {characters.map((char) => (
      <div class="group flex flex-col rounded-2xl overflow-hidden bg-white border border-slate-100/80 shadow-sm card-hover-effect">
        <!-- 角色形象卡片 (bllii 视觉标准) -->
        <div class="relative aspect-[16/10] w-full overflow-hidden bg-slate-100">
          <img
            src={char.avatar}
            alt={char.name}
            loading="lazy"
            class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent opacity-40 group-hover:opacity-60 transition-opacity"></div>
        </div>

        <!-- 角色名与配音声优 -->
        <div class="p-3">
          <h3 class="text-sm font-semibold text-slate-800 group-hover:text-primary-600 transition-colors">
            {char.name}
          </h3>
          <p class="text-xs text-slate-400 mt-0.5">
            {char.cv}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
