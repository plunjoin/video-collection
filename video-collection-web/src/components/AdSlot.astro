---
/**
 * 广告位组件（数据来自 /api/ads，由 admin 后台「广告位管理」配置）
 * - slot="banner"        首页顶部横幅
 * - slot="home_recommend" 首页推荐位（inline 模式混排进番剧列表）
 * - slot="detail"        详情/播放页横幅
 * admin 未配置或全部过期时组件自动隐藏，不留空白。
 * 广告点击通过 data-track="ad_click" 自动埋点。
 */
interface Props {
  slot: 'banner' | 'home_recommend' | 'detail';
  limit?: number;
  inline?: boolean;
  className?: string;
  dataTags?: string;
}
const { slot, limit = 1, inline = false, className = '', dataTags } = Astro.props;
---
<div
  class={`ad-slot ${inline ? 'ad-slot--inline' : ''} ${className}`.trim()}
  data-ad-slot={slot}
  data-ad-limit={limit}
  data-ad-inline={inline ? '1' : ''}
  data-tags={dataTags}
  hidden
>
</div>

<script>
  (function () {
    var escapeHtml = function (str) {
      return String(str ?? '').replace(/[&<>"']/g, function (m) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
      });
    };
    var resolveHref = function (ad) {
      var link = (ad.link || '').trim();
      if (link) return link;
      if (ad.video_id && ad.video_id > 0) return '/play/' + ad.video_id;
      return '';
    };

    document.querySelectorAll('[data-ad-slot]').forEach(function (box) {
      var slot = box.getAttribute('data-ad-slot');
      var limit = parseInt(box.getAttribute('data-ad-limit') || '1', 10) || 1;

      fetch('/api/ads?slot=' + encodeURIComponent(slot))
        .then(function (res) { return res.json(); })
        .then(function (json) {
          var ads = ((json && json.data) || []).filter(function (ad) { return ad && ad.image; });
          if (!ads.length) return;
          ads = ads.slice(0, limit);
          box.hidden = false;

          if (box.getAttribute('data-ad-inline') === '1') {
            // 首页推荐位：与番剧卡片同款尺寸混排
            box.innerHTML = ads.map(function (ad) {
              var href = resolveHref(ad) || '/category';
              var external = href.indexOf('http') === 0 ? ' target="_blank" rel="sponsored noopener"' : '';
              return (
                '<a href="' + escapeHtml(href) + '"' + external +
                ' class="anime-item group flex flex-col card-hover-effect ad-card" data-track="ad_click" data-track-id="' + ad.id + '">' +
                '<div class="relative aspect-[3/4] w-full rounded-2xl overflow-hidden bg-slate-200 shadow-sm group-hover:shadow-md transition-shadow">' +
                '<img src="' + escapeHtml(ad.image) + '" alt="' + escapeHtml(ad.title) + '" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" onerror="this.onerror=null;this.style.display=\'none\'" />' +
                '<span class="absolute top-2 left-2 px-1.5 py-0.5 rounded-full text-[10px] font-medium bg-black/45 text-white backdrop-blur-sm">广告</span>' +
                (ad.title ? '<span class="absolute bottom-0 left-0 right-0 px-2 py-1.5 text-[11px] text-white bg-gradient-to-t from-black/60 to-transparent line-clamp-1">' + escapeHtml(ad.title) + '</span>' : '') +
                '</div>' +
                '<div class="mt-2.5 px-0.5"><h3 class="text-sm font-semibold text-slate-800 group-hover:text-primary-600 transition-colors line-clamp-1">' + escapeHtml(ad.title || '推广') + '</h3>' +
                '<p class="text-xs text-slate-400 mt-0.5 line-clamp-1">推广内容</p></div>' +
                '</a>'
              );
            }).join('');
            return;
          }

          // banner / detail：横幅
          box.innerHTML = ads.map(function (ad) {
            var href = resolveHref(ad);
            if (!href) return '';
            var external = href.indexOf('http') === 0 ? ' target="_blank" rel="sponsored noopener"' : '';
            return (
              '<a href="' + escapeHtml(href) + '"' + external + ' class="ad-banner" data-track="ad_click" data-track-id="' + ad.id + '">' +
              '<img src="' + escapeHtml(ad.image) + '" alt="' + escapeHtml(ad.title) + '" class="ad-banner__img" loading="lazy" />' +
              '<span class="ad-banner__tag">广告</span>' +
              (ad.title ? '<span class="ad-banner__title">' + escapeHtml(ad.title) + '</span>' : '') +
              '</a>'
            );
          }).join('');
        })
        .catch(function () { /* 广告拉取失败静默隐藏 */ });
    });
  })();
</script>
