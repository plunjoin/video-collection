---
import BrandIcon from './BrandIcon.astro';
import type { VideoRecord } from '../lib/api';

interface Props {
  items?: VideoRecord[];
  currentVideo?: VideoRecord;
}

const { items = [], currentVideo } = Astro.props;

function getSeriesRoot(str?: string): string {
  if (!str) return '';
  return str
    .replace(/[（(\[【].*?[）)\]】]/g, ' ')
    .replace(/第[0-9一二三四五六七八九十百]+[季部期卷篇话回册次章集]/gi, ' ')
    .replace(/(Season\s*\d+|S\d+|Part\s*\d+|Vol\s*\d+|The\s+Final\s+Season|The\s+Movie)/gi, ' ')
    .replace(/(最终季|完结篇|终篇|前篇|后篇|剧场版|特别篇|总集篇|重制版|重置版|真人版|电影版|电视版|TV版|先行版|精编版|年番|篇|OVA|OAD|SP|BD|HD|4K|动态漫|动态漫画|普通话|国语|日语|中字|双语)/gi, ' ')
    .split(/[:：·\-_—/\s]+/)[0]
    .replace(/(II|III|IV|V|VI|VII|VIII|IX|X|\d+)$/i, '')
    .trim();
}

const currentRoot = currentVideo ? getSeriesRoot(currentVideo.name) : '';
---

<section id="tab-相关推荐" class="max-w-[1360px] mx-auto px-4 sm:px-6 mt-10">
  <div class="flex items-center justify-between mb-5">
    <div class="flex items-center gap-2.5">
      <div class="w-1.5 h-4 rounded-full bg-primary-600"></div>
      <h2 class="text-lg font-bold text-slate-800 tracking-tight">相关推荐</h2>
      <span class="text-xs text-slate-400 hidden sm:inline">
        (同系列连播与同题材热门精选)
      </span>
    </div>
    <a href="/category" class="text-xs sm:text-sm text-slate-400 hover:text-primary-600 flex items-center gap-1 transition-colors">
      <span>查看更多</span>
      <BrandIcon name="arrow-right" size={16} class="w-3.5 h-3.5" />
    </a>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3.5 sm:gap-4.5">
    {items.slice(0, 10).map((item) => {
      const isSameSeries = currentRoot && currentRoot.length >= 2 && item.name.includes(currentRoot);
      return (
        <a 
          href={`/play/${item.id}`}
          class="group flex flex-col card-hover-effect"
        >
          <div class="relative aspect-[3/4] w-full rounded-2xl overflow-hidden bg-slate-200 shadow-sm group-hover:shadow-md transition-shadow">
            <img
              src={item.picture || '/brand/bllii-app-blue.svg'}
              alt={item.name}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              onerror="this.onerror=null;this.src='/brand/bllii-app-blue.svg'"
            />

            <!-- 智能识别同系列与同类型角标 -->
            <div class="absolute top-2 left-2 flex flex-col gap-1">
              {isSameSeries ? (
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-primary-600/90 text-white backdrop-blur-sm shadow-sm flex items-center gap-0.5">
                  <span class="w-1 h-1 rounded-full bg-white animate-ping"></span>
                  同系列
                </span>
              ) : (
                <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-black/45 text-white/90 backdrop-blur-sm">
                  {item.type_name || '同类型'}
                </span>
              )}
            </div>

            <!-- 状态或集数备注 -->
            {item.remarks && (
              <span class="absolute top-2 right-2 px-2 py-0.5 rounded-full text-[10px] font-medium bg-black/60 text-white backdrop-blur-sm">
                {item.remarks}
              </span>
            )}
          </div>
          <div class="mt-2.5 px-0.5">
            <h3 class="text-sm font-semibold text-slate-800 group-hover:text-primary-600 transition-colors line-clamp-1">
              {item.name}
            </h3>
            <p class="text-[11px] text-slate-400 mt-0.5 line-clamp-1">
              {item.year ? `${item.year} · ` : ''}{item.area || '动漫'}
            </p>
          </div>
        </a>
      );
    })}
  </div>
</section>
