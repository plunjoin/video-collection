<Window x:Class="Bllii.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Bllii.Setup.Controls"
        Title="Bllii 安装程序"
        Width="1000" Height="628"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource Ink}"
        Icon="/Assets/bllii.ico">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="43" ResizeBorderThickness="0" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">

    <!-- ===== 主体（弹窗时整体虚化） ===== -->
    <Grid x:Name="ContentRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="43" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 标题栏 -->
      <Border Grid.Row="0" Background="White" BorderBrush="#EEEFF6" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
            <Image Source="/Assets/bllii-symbol.png" Width="23" Height="21" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
            <TextBlock x:Name="WindowTitle" Text="Bllii 安装程序" FontSize="11" Foreground="#7E8296"
                       Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimizeClick"
                    ToolTip="最小化">
              <Rectangle Width="11" Height="1" Fill="#7D8299" />
            </Button>
            <Button x:Name="BtnClose" Style="{StaticResource CloseCaptionButton}"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick"
                    ToolTip="关闭">
              <local:Icon Kind="Close" Width="15" Height="15"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 主体：左品牌 / 右内容 -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="37*" />
          <ColumnDefinition Width="63*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧品牌面板 ===== -->
        <Grid Grid.Column="0" ClipToBounds="True">
          <Rectangle Fill="{StaticResource BrandPanelFill}" />
          <Rectangle x:Name="BrandGlow" Fill="{StaticResource BrandPanelGlow}" />

          <Grid Margin="33,31,33,24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="255" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部 wordmark -->
            <Grid Grid.Row="0">
              <Image Source="/Assets/bllii-wordmark.png" Width="67" Height="37" Stretch="Uniform"
                     HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
              <local:SpacedText Text="FOR WINDOWS" FontSize="8" Tracking="1.5" Foreground="#8990B1"
                                HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- 品牌图形 -->
            <Grid Grid.Row="1" Margin="-33,0,-33,0" ClipToBounds="False">
              <Ellipse Width="300" Height="150" Stroke="#BDFFFFFF" StrokeThickness="1"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.RenderTransform>
                  <RotateTransform Angle="-32" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="290" Height="230" Stroke="#70FFFFFF" StrokeThickness="1"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.RenderTransform>
                  <RotateTransform Angle="47" />
                </Ellipse.RenderTransform>
              </Ellipse>

              <Rectangle Width="185" Height="185" RadiusX="81" RadiusY="81"
                         Fill="#99FFFFFF" Stroke="#BDFFFFFF" StrokeThickness="1"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle.RenderTransform>
                  <RotateTransform Angle="22" />
                </Rectangle.RenderTransform>
                <Rectangle.Effect>
                  <DropShadowEffect BlurRadius="26" ShadowDepth="10" Direction="270" Opacity="0.05" Color="#AFA5E6" />
                </Rectangle.Effect>
              </Rectangle>

              <Image x:Name="FloatingLogo" Source="/Assets/bllii-symbol.png" Width="204"
                     Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                     RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                  <TransformGroup>
                    <RotateTransform Angle="-8" />
                    <TranslateTransform x:Name="LogoFloat" />
                  </TransformGroup>
                </Image.RenderTransform>
                <Image.Effect>
                  <DropShadowEffect BlurRadius="22" ShadowDepth="18" Direction="270" Opacity="0.19" Color="#9A83FF" />
                </Image.Effect>
              </Image>

              <!-- 装饰星点 -->
              <TextBlock Text="✦" FontSize="24" Foreground="#A393EB" HorizontalAlignment="Left"
                         VerticalAlignment="Top" Margin="45,46,0,0" />
              <TextBlock Text="✦" FontSize="19" Foreground="#EDA2CD" HorizontalAlignment="Right"
                         VerticalAlignment="Bottom" Margin="0,0,42,37" />
              <Ellipse Width="7" Height="7" Fill="{StaticResource Blue}" HorizontalAlignment="Right"
                       VerticalAlignment="Top" Margin="0,64,51,0" />
              <Ellipse Width="5" Height="5" Fill="{StaticResource Pink}" HorizontalAlignment="Left"
                       VerticalAlignment="Bottom" Margin="51,0,0,52" />

              <!-- 玻璃标签 -->
              <Border Background="#B8FFFFFF" BorderBrush="#DDFFFFFF" BorderThickness="1" CornerRadius="10"
                      Padding="11,8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,0,48">
                <Border.RenderTransform>
                  <RotateTransform Angle="-7" />
                </Border.RenderTransform>
                <Border.Effect>
                  <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.10" Color="#9E93C9" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                  <local:Icon Kind="Heart" Width="13" Height="13" Stroke="#AC98EB" VerticalAlignment="Center" />
                  <local:SpacedText Text="每一份热爱" FontSize="10" Tracking="1" Foreground="#8481A4"
                                    Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Border>

              <Border Background="#B8FFFFFF" BorderBrush="#DDFFFFFF" BorderThickness="1" CornerRadius="10"
                      Padding="11,8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,45,21,0">
                <Border.RenderTransform>
                  <RotateTransform Angle="7" />
                </Border.RenderTransform>
                <Border.Effect>
                  <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.10" Color="#9E93C9" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                  <local:Icon Kind="Sparkle" Width="13" Height="13" Stroke="#EAA2CA" VerticalAlignment="Center" />
                  <local:SpacedText Text="都值得相遇" FontSize="10" Tracking="1" Foreground="#8481A4"
                                    Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- 品牌文案 -->
            <StackPanel Grid.Row="2" Margin="0,5,0,0">
              <Border Width="26" Height="3" CornerRadius="4" Background="{StaticResource BrandGradient}"
                      HorizontalAlignment="Left" Margin="0,0,0,18" />
              <TextBlock x:Name="BrandHeading" Style="{StaticResource BrandH2}" Margin="0,0,0,12">
                让每个故事，<LineBreak />生动一点。
              </TextBlock>
              <TextBlock x:Name="BrandDescription" Style="{StaticResource BrandP}" Margin="0,0,0,18"
                         Text="把热爱留在身边，把精彩交给 Bllii。" TextWrapping="Wrap" />
              <local:SpacedText x:Name="BrandSlogan" Text="More Stories, Together" FontSize="10" Tracking="1.9"
                                Foreground="#8B8EAD" />
            </StackPanel>

            <!-- 底部 -->
            <Grid Grid.Row="3" VerticalAlignment="Bottom" Margin="0,25,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Ellipse Width="5" Height="5" Fill="{StaticResource Blue}" />
                <Ellipse Width="5" Height="5" Fill="{StaticResource Purple}" Margin="5,0,0,0" />
                <Ellipse Width="5" Height="5" Fill="{StaticResource Pink}" Margin="5,0,0,0" />
              </StackPanel>
              <local:SpacedText Text="YOUR NEXT STORY AWAITS" FontSize="7" Tracking="1.3" Foreground="#9899B7"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
          </Grid>
        </Grid>

        <!-- ===== 右侧内容面板 ===== -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="43,38,43,0">

            <!-- 安装：准备 -->
            <Grid x:Name="PageInstallWelcome">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,1,0,22">
                  <Ellipse Width="5" Height="5" Fill="{StaticResource Purple}" VerticalAlignment="Center" />
                  <local:SpacedText Text="HELLO, NEW STORIES" FontSize="9" Tracking="1.8" Foreground="#969AB0"
                                    Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="把精彩，装进桌面。" Style="{StaticResource H1}" Margin="0,0,0,10" />
                <TextBlock Text="欢迎使用 Bllii。只需一步，就能开启新的故事。" Style="{StaticResource Desc}" />

                <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                  <Border Background="#F3F0FC" CornerRadius="5" Padding="7,4">
                    <StackPanel Orientation="Horizontal">
                      <local:Icon Kind="Desktop" Width="11" Height="11" Stroke="#8176AE" VerticalAlignment="Center" />
                      <TextBlock Text="Windows x64" FontSize="10" Foreground="#8176AE" Margin="5,0,0,0"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Ellipse Width="2" Height="2" Fill="#A9ADBC" Margin="9,0" VerticalAlignment="Center" />
                  <TextBlock Text="版本 1.0.1" FontSize="10" Foreground="#9296AA" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Row="1" Margin="0,28,0,0">
                <Grid Margin="0,0,0,9">
                  <TextBlock Text="安装位置" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="可自定义目录" FontSize="10" Foreground="#A0A3B4" HorizontalAlignment="Right" />
                </Grid>

                <Border x:Name="PathField" CornerRadius="9" Background="{StaticResource FieldFill}"
                        BorderBrush="#E6E8F1" BorderThickness="1" Padding="12,0" Height="40">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:Icon Grid.Column="0" Kind="Folder" Width="17" Height="17" Stroke="#9E98B7"
                                VerticalAlignment="Center" />
                    <TextBox x:Name="PathInput" Grid.Column="1" Style="{StaticResource BareTextBox}"
                             Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Grid.Column="2" BorderBrush="#E5E4F0" BorderThickness="1,0,0,0" Margin="10,9,0,9"
                            Padding="8,0,0,0">
                      <Button Content="更改" Style="{StaticResource TextButton}" Foreground="#7061CE"
                              Padding="0" VerticalAlignment="Center" Click="OnBrowseClick" />
                    </Border>
                  </Grid>
                </Border>

                <TextBlock x:Name="PathError" Visibility="Collapsed" Margin="0,8,0,0"
                           Text="请输入有效的 Windows 路径，例如 D:\Apps\Bllii。"
                           FontSize="10" Foreground="#BD6871" />

                <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                  <CheckBox x:Name="ChkDesktop" Content="创建桌面快捷方式" Style="{StaticResource CheckOption}"
                            IsChecked="True" />
                  <CheckBox x:Name="ChkLaunch" Content="安装后启动 Bllii" Style="{StaticResource CheckOption}"
                            IsChecked="True" Margin="21,0,0,0" />
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Row="2" Margin="0,0,0,25">
                <Button x:Name="BtnInstall" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                        Click="OnInstallClick">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="安装 Bllii" VerticalAlignment="Center" />
                    <local:Icon Kind="Arrow" Width="17" Height="17" Stroke="White" Margin="12,0,0,0"
                                VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Text="安装后可在 Windows 设置中随时卸载" Style="{StaticResource Note}" Margin="0,11,0,0" />
              </StackPanel>
            </Grid>

            <!-- 卸载：确认 -->
            <Grid x:Name="PageUninstall" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,1,0,22">
                  <Ellipse Width="5" Height="5" Fill="{StaticResource Purple}" VerticalAlignment="Center" />
                  <local:SpacedText Text="UNTIL THE NEXT STORY" FontSize="9" Tracking="1.8" Foreground="#969AB0"
                                    Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="和 Bllii 暂别一下。" Style="{StaticResource H1}" Margin="0,0,0,10" />
                <TextBlock Text="谢谢你，让 Bllii 陪你度过一段好时光。" Style="{StaticResource Desc}" />
              </StackPanel>

              <StackPanel Grid.Row="1">
                <Border Background="#F8F9FD" CornerRadius="11" Padding="15,13" Margin="0,22,0,20">
                  <StackPanel Orientation="Horizontal">
                    <Rectangle Width="42" Height="42" RadiusX="11" RadiusY="11">
                      <Rectangle.Fill>
                        <ImageBrush ImageSource="/Assets/bllii-app-light.png" Stretch="UniformToFill" />
                      </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Bllii 桌面客户端" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                      <TextBlock Text="版本 1.0.1 · Windows x64" FontSize="10" Foreground="#969BB0" Margin="0,4,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Text="卸载时，如何处理本地数据？" FontSize="11" Foreground="#73788E" Margin="0,0,0,11" />

                <RadioButton x:Name="RadioKeep" Style="{StaticResource RadioOption}" IsChecked="True" GroupName="data">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="保留本地数据" FontSize="11" Foreground="{StaticResource Ink}" />
                      <Border Background="#ECE8FA" CornerRadius="4" Padding="5,2" Margin="6,0,0,0">
                        <TextBlock Text="推荐" FontSize="8" Foreground="#9381C5" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="保留设置与观看记录，下次安装时继续使用。" FontSize="10" Foreground="#9295AB"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RadioRemove" Style="{StaticResource RadioOption}" GroupName="data" Margin="0,9,0,0">
                  <StackPanel>
                    <TextBlock Text="同时清除本地数据" FontSize="11" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="删除这台电脑上的设置、登录状态与观看记录。" FontSize="10" Foreground="#9295AB"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>

              <StackPanel Grid.Row="2" Margin="0,0,0,25">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Content="先留下吧" Style="{StaticResource SoftButton}" Click="OnKeepClick" />
                  <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="OnUninstallClick">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="确认卸载" VerticalAlignment="Center" />
                      <local:Icon Kind="Arrow" Width="17" Height="17" Stroke="White" Margin="12,0,0,0"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
                <TextBlock Text="仅处理此电脑上的应用与所选本地数据" Style="{StaticResource Note}" Margin="0,11,0,0" />
              </StackPanel>
            </Grid>

            <!-- 进度 -->
            <Grid x:Name="PageProgress" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,1,0,22">
                  <Ellipse Width="5" Height="5" Fill="{StaticResource Purple}" VerticalAlignment="Center" />
                  <local:SpacedText x:Name="ProgressKicker" Text="GETTING EVERYTHING READY" FontSize="9" Tracking="1.8"
                                    Foreground="#969AB0" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ProgressHeading" Text="好故事，即将开场。" Style="{StaticResource H1}" Margin="0,0,0,10" />
                <TextBlock x:Name="ProgressDescription" Text="正在为你准备桌面上的新伙伴，请稍候。"
                           Style="{StaticResource Desc}" />
              </StackPanel>

              <StackPanel Grid.Row="1">
                <Grid Width="120" Height="112" HorizontalAlignment="Center" Margin="0,24,0,14">
                  <Ellipse Width="92" Height="92" Fill="#F5F2FF" />
                  <Grid Width="108" Height="108" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Stroke="#EDE8FB" StrokeThickness="2.5" />
                    <Path StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M54,2 A52,52 0 0 1 106,54">
                      <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="#4B9FFF" Offset="0" />
                          <GradientStop Color="#9A83FF" Offset="1" />
                        </LinearGradientBrush>
                      </Path.Stroke>
                      <Path.RenderTransform>
                        <RotateTransform x:Name="ArcRotate" CenterX="54" CenterY="54" />
                      </Path.RenderTransform>
                    </Path>
                  </Grid>
                  <Image Source="/Assets/bllii-symbol.png" Width="64" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,0,0,13">
                  <TextBlock x:Name="ProgressCaption" Text="正在准备安装文件" FontSize="12" Foreground="{StaticResource Body}"
                             VerticalAlignment="Center" />
                  <TextBlock x:Name="ProgressPercent" Text="0%" FontSize="14" Foreground="#8E7ED9"
                             HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <ProgressBar x:Name="Bar" Style="{StaticResource BrandProgress}" Value="0" />

                <Grid Margin="0,10,0,21">
                  <TextBlock x:Name="ProgressFile" Text="准备安装目录" FontSize="10" Foreground="#9A9EB2"
                             TextTrimming="CharacterEllipsis" Margin="0,0,60,0" />
                  <TextBlock Text="请稍候" FontSize="10" Foreground="#9A9EB2" HorizontalAlignment="Right" />
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel x:Name="Step0" Grid.Column="0" Orientation="Horizontal">
                    <local:Icon x:Name="StepIcon0" Kind="Check" Width="12" Height="12" Stroke="#8A7BC1"
                                VerticalAlignment="Center" />
                    <TextBlock x:Name="StepText0" Text="准备文件" FontSize="10" Foreground="#8A7BC1"
                               Margin="5,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel x:Name="Step1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <local:Icon x:Name="StepIcon1" Kind="Desktop" Width="12" Height="12" Stroke="#A5A8B9"
                                VerticalAlignment="Center" />
                    <TextBlock x:Name="StepText1" Text="安装应用" FontSize="10" Foreground="#A5A8B9"
                               Margin="5,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel x:Name="Step2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <local:Icon x:Name="StepIcon2" Kind="Desktop" Width="12" Height="12" Stroke="#A5A8B9"
                                VerticalAlignment="Center" />
                    <TextBlock x:Name="StepText2" Text="完成配置" FontSize="10" Foreground="#A5A8B9"
                               Margin="5,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <TextBlock x:Name="ProgressNote" Grid.Row="2" Text="精彩正在路上，马上就好。"
                         Style="{StaticResource Note}" Margin="0,0,0,30" />
            </Grid>

            <!-- 完成 -->
            <Grid x:Name="PageSuccess" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,1,0,22">
                  <Ellipse Width="5" Height="5" Fill="{StaticResource Purple}" VerticalAlignment="Center" />
                  <local:SpacedText x:Name="SuccessKicker" Text="READY FOR YOUR NEXT STORY" FontSize="9" Tracking="1.8"
                                    Foreground="#969AB0" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SuccessHeading" Text="准备好了，开场吧！" Style="{StaticResource H1}" Margin="0,0,0,10" />
                <TextBlock x:Name="SuccessDescription" Text="Bllii 已准备就绪，新的故事正等着你。"
                           Style="{StaticResource Desc}" />
              </StackPanel>

              <StackPanel Grid.Row="1">
                <Grid Width="120" Height="112" HorizontalAlignment="Center" Margin="0,23,0,22">
                  <Ellipse Width="92" Height="92" Fill="#F5F2FF" />
                  <Image Source="/Assets/bllii-symbol.png" Width="80" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                  <Border Width="31" Height="31" CornerRadius="16" Background="#8274D2" BorderBrush="White"
                          BorderThickness="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,3,3">
                    <local:Icon Kind="Check" Width="13" Height="13" Stroke="White" HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                  </Border>
                </Grid>

                <Border Background="{StaticResource CardFill}" CornerRadius="9" Padding="15" Margin="0,20,0,0">
                  <StackPanel Orientation="Horizontal">
                    <local:Icon x:Name="SuccessNoteIcon" Kind="Desktop" Width="22" Height="22" Stroke="#9486CF"
                                VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0">
                      <TextBlock x:Name="SuccessNoteTitle" Text="桌面见，我们的故事继续。" FontSize="11"
                                 Foreground="{StaticResource Ink}" />
                      <TextBlock x:Name="SuccessNoteBody" Text="双击桌面上的 Bllii，即可再次打开。" FontSize="10"
                                 Foreground="#9396AB" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Grid.Row="2" Margin="0,0,0,25">
                <Button x:Name="BtnFinish" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                        Click="OnFinishClick">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FinishLabel" Text="开启 Bllii" VerticalAlignment="Center" />
                    <local:Icon x:Name="FinishIcon" Kind="Arrow" Width="17" Height="17" Stroke="White"
                                Margin="12,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock x:Name="SuccessNote" Text="More Stories, Together" Style="{StaticResource Note}"
                           Margin="0,11,0,0" />
              </StackPanel>
            </Grid>

            <!-- 异常 -->
            <Grid x:Name="PageError" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,1,0,22">
                  <Ellipse Width="5" Height="5" Fill="{StaticResource Purple}" VerticalAlignment="Center" />
                  <local:SpacedText Text="LET’S TRY THAT AGAIN" FontSize="9" Tracking="1.8" Foreground="#969AB0"
                                    Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ErrorHeading" Text="安装遇到一点小插曲。" Style="{StaticResource H1}" Margin="0,0,0,10" />
                <TextBlock Text="不用着急，处理后可以继续。" Style="{StaticResource Desc}" />
              </StackPanel>

              <StackPanel Grid.Row="1">
                <Border Background="#FFF6F5" BorderBrush="#F9E6E3" BorderThickness="1" CornerRadius="9"
                        Padding="14" Margin="0,27,0,0">
                  <StackPanel Orientation="Horizontal">
                    <local:Icon Kind="Info" Width="18" Height="18" Stroke="#CA7A78" VerticalAlignment="Top" />
                    <StackPanel Margin="10,0,0,0">
                      <TextBlock x:Name="ErrorTitle" Text="暂时无法写入安装目录" FontSize="12" Foreground="#A66D6D" />
                      <TextBlock x:Name="ErrorBody" Text="请检查文件夹的写入权限，或更换一个安装位置。" FontSize="11"
                                 Foreground="#AD9292" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19.8" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorStepA" Text="1. 确认所选磁盘有足够的可用空间。" FontSize="11" Foreground="#8D8DA5"
                           Margin="18,20,0,0" LineHeight="23" />
                <TextBlock x:Name="ErrorStepB" Text="2. 关闭占用安装文件夹的应用后重试。" FontSize="11" Foreground="#8D8DA5"
                           Margin="18,0,0,0" LineHeight="23" />
              </StackPanel>

              <StackPanel Grid.Row="2" Margin="0,0,0,25">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BtnErrorBack" Grid.Column="0" Content="更改位置" Style="{StaticResource SoftButton}"
                          Click="OnErrorBackClick" />
                  <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="OnErrorRetryClick">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="RetryLabel" Text="重试安装" VerticalAlignment="Center" />
                      <local:Icon Kind="Arrow" Width="17" Height="17" Stroke="White" Margin="12,0,0,0"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
                <TextBlock x:Name="ErrorNote" Text="你的安装选项已保留" Style="{StaticResource Note}" Margin="0,11,0,0" />
              </StackPanel>
            </Grid>
          </Grid>

          <!-- 页脚 -->
          <Border Grid.Row="1" Margin="43,0,43,18" BorderBrush="{StaticResource HairlineSoft}"
                  BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <local:Icon Kind="Shield" Width="12" Height="12" Stroke="#AAA4C6" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterLabel" Text="为当前用户安装" FontSize="9" Foreground="#A3A7B8"
                           Margin="5,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="Bllii · Windows x64" FontSize="9" Foreground="#A3A7B8" HorizontalAlignment="Right" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- ===== 自绘对话框 ===== -->
    <Grid x:Name="Overlay" Visibility="Collapsed" Background="#353B5845">
      <Border Width="410" Background="White" CornerRadius="16" BorderBrush="#EEEDF6" BorderThickness="1"
              Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect BlurRadius="90" ShadowDepth="25" Direction="270" Opacity="0.27" Color="#353B58" />
        </Border.Effect>
        <StackPanel>
          <TextBlock x:Name="DialogTitle" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                     Margin="0,0,0,12" TextWrapping="Wrap" />
          <TextBlock x:Name="DialogBody" FontSize="12" LineHeight="22.8" Foreground="{StaticResource Muted}"
                     TextWrapping="Wrap" />
          <StackPanel x:Name="DialogActions" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
